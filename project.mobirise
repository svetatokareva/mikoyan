          "_name": "testimonials2",
          "_customHTML": "<section class=\"testimonials2\" group=\"Testimonials\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n      <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"8\">\n      <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"0\">\n\n      <input type=\"range\" inline title=\"Media Size\" name=\"mediaSize\" min=\"10\" max=\"200\" step=\"5\" value=\"130\">\n\n      <fieldset type=\"background\" name=\"bg\" parallax>\n          <input type=\"image\" title=\"Background Image\" value=\"../_images/background3.jpg\">\n          <input type=\"color\" title=\"Background Color\" value=\"#ffffff\" selected>\n          <input type=\"video\" title=\"Background Video\" value=\"http://www.youtube.com/watch?v=uNCr7NdOJgw\">\n      </fieldset>\n      <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n      <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#232323\" condition=\"overlay && bg.type !== 'color'\">\n      <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n    <!-- End block parameters --> \n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div class=\"container\">\n        <div class=\"media-container-row\">\n            <div class=\"mbr-figure pr-lg-5\" mbr-style=\"{'width':'50%'}\">\n              <img src=\"@PROJECT_PATH@/assets/images/untitled2-3.jpeg\" alt title>\n            </div>\n            <div class=\"media-content px-3 align-self-center mbr-white py-2\">\n                    <p class=\"mbr-text testimonial-text mbr-fonts-style\" mbr-theme-style=\"display-1\" data-app-selector=\".testimonial-text\"><b>ТАРАСОВ</b><br><b>Павел Иванович</b></p>\n                    <p class=\"mbr-author-name pt-4 mb-2 mbr-fonts-style\" mbr-theme-style=\"display-1\" data-app-selector=\".mbr-author-name\"><span style=\"font-weight: normal;\">? - ?</span><br></p>\n                    <p class=\"mbr-author-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-author-desc\"></p>\n            </div>\n        </div>\n    </div>\n</section>",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_cid": "rPpHMzhVRZ",
          "_anchor": "testimonials2-1e3",
          "_sourceTheme": "mobirise4",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "background-color": "@bgColor",
            ".line": {
              "background-color": "@lineColor",
              "color": "@lineColor",
              "align": "center",
              "height": "2px",
              "margin": "0 auto"
            },
            ".section-text": {
              "padding": "2rem 0",
              "text-align": "left"
            },
            ".inner-container": {
              "margin": "0 auto"
            },
            "@media (max-width: 768px)": {
              ".inner-container": {
                "width": "100% !important"
              }
            },
            ".section-text DIV": {
              "text-align": "left"
            }
          },
          "_name": "content9",
          "_customHTML": "<section class=\"mbr-section article content9\" group=\"Article\">\n    \n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"0\">\n        <input type=\"range\" inline title=\"Text Width\" name=\"innerWidth\" min=\"50\" max=\"100\" step=\"1\" value=\"100\">\n        <input type=\"range\" inline title=\"Line Width\" name=\"lineLength\" min=\"10\" max=\"100\" step=\"1\" value=\"25\">\n        <input type=\"color\" title=\"Line Color\" name=\"lineColor\" value=\"#149dcc\">\n        <input type=\"color\" title=\"Background Color\" name=\"bgColor\" value=\"#ffffff\">\n    <!-- End block parameters -->\n    </mbr-parameters> \n\n    <div class=\"container\">\n        <div class=\"inner-container\" mbr-style=\"{'width': innerWidth + '%'}\">\n            <hr class=\"line\" mbr-style=\"{'width': lineLength + '%'}\">\n            <div class=\"section-text align-center mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".section-text\" mbr-text><p>&nbsp; &nbsp; Павел Иванович Тарасов до войны жил в городе Николаеве, работал\n&nbsp;<span style=\"font-size: 1.2rem;\">гарантийным механиком на судостроительном Николаевском заводе завода им. А.&nbsp;</span><span style=\"font-size: 1.2rem;\">Марти.&nbsp;</span></p><br><p>&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"font-size: 1.2rem;\">В 1941 году Тарасов П.И. был мобилизован, стал краснофлотцем и вместе&nbsp;</span><span style=\"font-size: 1.2rem;\">с&nbsp;другими «николаевцами – судостроителями» продолжил службу матросом&nbsp;</span><span style=\"font-size: 1.2rem;\">–&nbsp;механиком на вспомогательном крейсере Черноморского флота, ледоколе&nbsp;</span><span style=\"font-size: 1.2rem;\">«Анастас Микоян», в строительстве которого он, видимо, принимал участие.&nbsp;</span></p><br><p>&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"font-size: 1.2rem;\">В составе экипажа корабля краснофлотец Тарасов П.И. участвовал в обороне&nbsp;</span><span style=\"font-size: 1.2rem;\">Одессы, Севастополя и Новороссийска. &nbsp;</span></p><br><p>&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"font-size: 1.2rem;\">В 1941 – 1942 годах краснофлотец механик Тарасов П.И. участвовал в&nbsp;</span><span style=\"font-size: 1.2rem;\">кругосветном переходе ледокола «Анастас Микоян» из Чёрного моря в&nbsp;</span><span style=\"font-size: 1.2rem;\">Бухту&nbsp;Провидения (Анадырский залив, Берингово море). &nbsp;</span></p><br><p>&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"font-size: 1.2rem;\">После прибытия в Молотовск (ныне Северодвинск) и расформирования экипажа&nbsp;</span><span style=\"font-size: 1.2rem;\">ледокола «А.Микоян», Павел Иванович Тарасов работал на заводе №-402.&nbsp;</span></p><br><p>&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"font-size: 1.2rem;\">Во время Великой Отечественной войны судостроительная верфь «Завод №&nbsp;402»&nbsp;</span><span style=\"font-size: 1.2rem;\">в Молотовске (ныне Северодвинск) успешно выполняла ремонт и модернизацию&nbsp;</span><span style=\"font-size: 1.2rem;\">боевых надводных кораблей, получивших «боевые ранения», а также ранения от&nbsp;</span><span style=\"font-size: 1.2rem;\">сжатия льдами. Ремонтные работы велись на заводе №&nbsp;402 ускоренными&nbsp;</span><span style=\"font-size: 1.2rem;\">темпами. Жесткие сроки судоремонтных работ с самого начала устанавливались&nbsp;</span><span style=\"font-size: 1.2rem;\">руководством страны и строго контролировались заместителем Председателя&nbsp;</span><span style=\"font-size: 1.2rem;\">Совнаркома СССР, членом ГКО, ответственным за все поставки из-за границы,&nbsp;</span><span style=\"font-size: 1.2rem;\">А.И. Микояном. &nbsp;</span><span style=\"font-size: 1.2rem;\">С 1943 года судостроительная верфь «Завод №&nbsp;402» приступила к изготовлению&nbsp;</span><span style=\"font-size: 1.2rem;\">и поставке для ВМФ СССР новых боевых кораблей: больших морских охотников,&nbsp;</span><span style=\"font-size: 1.2rem;\">эскадренных миноносцев, легких крейсеров.&nbsp;</span><span style=\"font-size: 1.2rem;\">С 1943 по 1955 годы на судостроительной верфи «Завод №&nbsp;402» было построено&nbsp;</span><span style=\"font-size: 1.2rem;\">45 новых боевых надводных кораблей.</span></p></div>\n            <hr class=\"line\" mbr-style=\"{'width': lineLength + '%'}\">\n        </div>\n        </div>\n</section>",
