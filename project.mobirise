        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".testimonial-text": {
              "font-style": "italic",
              "font-weight": "300",
              "color": "#232323"
            },
            ".mbr-author-name": {
              "font-weight": "bold",
              "color": "#232323"
            },
            ".media-container-row": {
              "word-wrap": "break-word",
              "word-break": "break-word"
            },
            "@media (max-width: 991px)": {
              ".mbr-figure, img": {
                "max-height": "300px",
                "width": "auto",
                "margin": "auto"
              },
              ".media-content": {
                "padding-top": "1.5rem !important"
              }
            },
            ".mbr-author-desc": {
              "color": "#232323"
            }
          },
          "_name": "testimonials2",
          "_customHTML": "<section class=\"testimonials2\" group=\"Testimonials\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n      <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"8\">\n      <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"0\">\n\n      <input type=\"range\" inline title=\"Media Size\" name=\"mediaSize\" min=\"10\" max=\"200\" step=\"5\" value=\"130\">\n\n      <fieldset type=\"background\" name=\"bg\" parallax>\n          <input type=\"image\" title=\"Background Image\" value=\"../_images/background3.jpg\">\n          <input type=\"color\" title=\"Background Color\" value=\"#ffffff\" selected>\n          <input type=\"video\" title=\"Background Video\" value=\"http://www.youtube.com/watch?v=uNCr7NdOJgw\">\n      </fieldset>\n      <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n      <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#232323\" condition=\"overlay && bg.type !== 'color'\">\n      <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n    <!-- End block parameters --> \n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div class=\"container\">\n        <div class=\"media-container-row\">\n            <div class=\"mbr-figure pr-lg-5\" mbr-style=\"{'width':'50%'}\">\n              <img src=\"@PROJECT_PATH@/assets/images/untitled2-3.jpeg\" alt title>\n            </div>\n            <div class=\"media-content px-3 align-self-center mbr-white py-2\">\n                    <p class=\"mbr-text testimonial-text mbr-fonts-style\" mbr-theme-style=\"display-1\" data-app-selector=\".testimonial-text\"><b>КОВАЛЬ</b><br><b>Николай Ефремович</b></p>\n                    <p class=\"mbr-author-name pt-4 mb-2 mbr-fonts-style\" mbr-theme-style=\"display-1\" data-app-selector=\".mbr-author-name\"><span style=\"font-weight: normal;font-size: 1.9rem;\">Радист<br></span><br><span style=\"font-weight: normal;\">1916 - ?</span><br></p>\n                    <p class=\"mbr-author-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-author-desc\"></p>\n            </div>\n        </div>\n    </div>\n</section>",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_cid": "rBU2ZFsAbb",
          "_anchor": "testimonials2-2z",
          "_sourceTheme": "mobirise4",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "background-color": "@bgColor",
            ".line": {
              "background-color": "@lineColor",
              "color": "@lineColor",
              "align": "center",
              "height": "2px",
              "margin": "0 auto"
            },
            ".section-text": {
              "padding": "2rem 0",
              "text-align": "left"
            },
            ".inner-container": {
              "margin": "0 auto"
            },
            "@media (max-width: 768px)": {
              ".inner-container": {
                "width": "100% !important"
              }
            },
            ".section-text DIV": {
              "text-align": "left"
            }
          },
          "_name": "content9",
          "_customHTML": "<section class=\"mbr-section article content9\" group=\"Article\">\n    \n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"0\">\n        <input type=\"range\" inline title=\"Text Width\" name=\"innerWidth\" min=\"50\" max=\"100\" step=\"1\" value=\"100\">\n        <input type=\"range\" inline title=\"Line Width\" name=\"lineLength\" min=\"10\" max=\"100\" step=\"1\" value=\"25\">\n        <input type=\"color\" title=\"Line Color\" name=\"lineColor\" value=\"#149dcc\">\n        <input type=\"color\" title=\"Background Color\" name=\"bgColor\" value=\"#ffffff\">\n    <!-- End block parameters -->\n    </mbr-parameters> \n\n    <div class=\"container\">\n        <div class=\"inner-container\" mbr-style=\"{'width': innerWidth + '%'}\">\n            <hr class=\"line\" mbr-style=\"{'width': lineLength + '%'}\">\n            <div class=\"section-text align-center mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".section-text\" mbr-text><div>&nbsp;&nbsp;&nbsp;&nbsp;Коваль Николай Ефремович родился 22 мая 1916.</div><br><div>&nbsp; &nbsp;&nbsp;<span style=\"font-size: 1.2rem;\">В начале войны Коваль Н.Е. служил радистом на эсминце \"Быстрый\", которым &nbsp;</span><span style=\"font-size: 1.2rem;\">командовал капитан II ранга С.М. Сергеев. Во время взрыва в Севастопольской&nbsp;</span><span style=\"font-size: 1.2rem;\">бухте эсминца \"Быстрый\" Коваль Н.Е. был ранен, находился на излечении в&nbsp;</span><span style=\"font-size: 1.2rem;\">госпитале, куда однажды прибыл Полещук Е.Г. с призывом идти на \"Микоян\" для&nbsp;</span><span style=\"font-size: 1.2rem;\">обороны Одессы.&nbsp;</span><span style=\"font-size: 1.2rem;\">Коваль, не раздумывая, добровольно сразу ушел служить на «Микоян», не&nbsp;</span><span style=\"font-size: 1.2rem;\">дожидаясь приказа.</span></div><br><div>&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"font-size: 1.2rem;\">На вспомогательном крейсере – ледоколе «Анастас Микоян» Коваль Н.Е.&nbsp;</span><span style=\"font-size: 1.2rem;\">служил радистом.&nbsp;</span></div><br><div>&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"font-size: 1.2rem;\">В составе экипажа корабля Коваль Н.Е. участвовал в обороне Одессы и&nbsp;</span><span style=\"font-size: 1.2rem;\">Севастополя. </span></div><br><div>&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"font-size: 1.2rem;\">В 1941 – 1942 годах радист Коваль Н.Е. участвовал в кругосветном переходе&nbsp;</span><span style=\"font-size: 1.2rem;\">ледокола \"Анастас Микоян\" из Чёрного моря в Бухту Провидения (Анадырский&nbsp;</span><span style=\"font-size: 1.2rem;\">залив, Берингово море).&nbsp;</span></div><br><div><span style=\"font-size: 1.2rem;\">&nbsp; &nbsp;После расформирования экипажа Коваль Н.Е. был направлен в Беломорский\n&nbsp;</span><span style=\"font-size: 1.2rem;\">район СНИС (служба наблюдения и связи) Северного Флота радистом.&nbsp;</span><br></div><br><div>&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"font-size: 1.2rem;\">Демобилизовался в конце 1946 года.&nbsp;</span></div><br><div><span style=\"font-size: 1.2rem;\">&nbsp; &nbsp;С 1947 по 1951 год Коваль Н.Е. работал в Николаеве. В 1951 завербовался в\n&nbsp;</span><span style=\"font-size: 1.2rem;\">Дальстрой МВД на крайнем севере радистом на морской буксир и около 25 лет&nbsp;</span><span style=\"font-size: 1.2rem;\">проработал на разных должностях в морском торговом порту Нагаево (Бухта&nbsp;</span><span style=\"font-size: 1.2rem;\">Нагаево, Тауйская губа, северное побережье Охотского моря).&nbsp;</span><br></div><br><div><span style=\"font-size: 1.2rem;\">&nbsp; &nbsp;В 1954 году окончил курсы судоводителя до 200 регистровых тонн.&nbsp;</span></div><br><div>&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"font-size: 1.2rem;\">С 1955 года Коваль Н.Е. работал помощником капитана на буксире, а также&nbsp;</span><span style=\"font-size: 1.2rem;\">радистом.&nbsp;</span></div><br><div>&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"font-size: 1.2rem;\">В 1975 году работал капитаном инспекции портнадзора в морском торговом порту&nbsp;</span><span style=\"font-size: 1.2rem;\">Нагаево в Магадане.&nbsp;</span></div><br><div><span style=\"font-size: 1.2rem;\">&nbsp; &nbsp;Женился Николай Ефремович в 1946 году. Имел трёх дочерей.</span><br></div><br><div>&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"font-size: 1.2rem;\">В 1976 году Коваль Н.Е. вернулся в Николаев, где проживали его старшая дочь&nbsp;</span><span style=\"font-size: 1.2rem;\">(воспитатель в детском саду) и больная мать. </span></div><br><div><span style=\"font-size: 1.2rem;\">&nbsp; &nbsp;Сам себя Коваль Н.Е. в письме капитану Сергееву С.М. описывал так: \"Никогда\n&nbsp;</span><span style=\"font-size: 1.2rem;\">не курил и не пил. Не горевал, не испытывал тяжкой нужды и горя.&nbsp;</span><span style=\"font-size: 1.2rem;\">Безукоризненно работал, был благожелателен к людям\".</span><br></div></div>\n            <hr class=\"line\" mbr-style=\"{'width': lineLength + '%'}\">\n        </div>\n        </div>\n</section>",
          "_cid": "rBU2ZFYBDM",
