          "_name": "testimonials2",
          "_customHTML": "<section class=\"testimonials2\" group=\"Testimonials\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n      <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"8\">\n      <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"0\">\n\n      <input type=\"range\" inline title=\"Media Size\" name=\"mediaSize\" min=\"10\" max=\"200\" step=\"5\" value=\"130\">\n\n      <fieldset type=\"background\" name=\"bg\" parallax>\n          <input type=\"image\" title=\"Background Image\" value=\"../_images/background3.jpg\">\n          <input type=\"color\" title=\"Background Color\" value=\"#ffffff\" selected>\n          <input type=\"video\" title=\"Background Video\" value=\"http://www.youtube.com/watch?v=uNCr7NdOJgw\">\n      </fieldset>\n      <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n      <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#232323\" condition=\"overlay && bg.type !== 'color'\">\n      <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n    <!-- End block parameters --> \n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div class=\"container\">\n        <div class=\"media-container-row\">\n            <div class=\"mbr-figure pr-lg-5\" mbr-style=\"{'width':'50%'}\">\n              <img src=\"@PROJECT_PATH@/assets/images/1942-3-421x506.jpeg\" alt title>\n            </div>\n            <div class=\"media-content px-3 align-self-center mbr-white py-2\">\n                    <p class=\"mbr-text testimonial-text mbr-fonts-style\" mbr-theme-style=\"display-1\" data-app-selector=\".testimonial-text\"><b>ДРОБНИЧ</b><br><b>Иван Георгиевич</b></p>\n                    <p class=\"mbr-author-name pt-4 mb-2 mbr-fonts-style\" mbr-theme-style=\"display-1\" data-app-selector=\".mbr-author-name\"><span style=\"font-weight: normal;font-size: 1.9rem;\">Старшина 2 статьи</span><br><span style=\"font-weight: normal;font-size: 1.9rem;\">Дизельный механик&nbsp;<br></span><br><span style=\"font-weight: normal;\">1912 - 1955</span><br></p>\n                    <p class=\"mbr-author-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-author-desc\"></p>\n            </div>\n        </div>\n    </div>\n</section>",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_cid": "rVkFVVE9ma",
          "_anchor": "testimonials2-1mo",
          "_sourceTheme": "mobirise4",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "background-color": "@bgColor",
            ".line": {
              "background-color": "@lineColor",
              "color": "@lineColor",
              "align": "center",
              "height": "2px",
              "margin": "0 auto"
            },
            ".section-text": {
              "padding": "2rem 0",
              "text-align": "left"
            },
            ".inner-container": {
              "margin": "0 auto"
            },
            "@media (max-width: 768px)": {
              ".inner-container": {
                "width": "100% !important"
              }
            },
            ".section-text DIV": {
              "text-align": "left"
            }
          },
          "_name": "content9",
          "_customHTML": "<section class=\"mbr-section article content9\" group=\"Article\">\n    \n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"0\">\n        <input type=\"range\" inline title=\"Text Width\" name=\"innerWidth\" min=\"50\" max=\"100\" step=\"1\" value=\"100\">\n        <input type=\"range\" inline title=\"Line Width\" name=\"lineLength\" min=\"10\" max=\"100\" step=\"1\" value=\"25\">\n        <input type=\"color\" title=\"Line Color\" name=\"lineColor\" value=\"#149dcc\">\n        <input type=\"color\" title=\"Background Color\" name=\"bgColor\" value=\"#ffffff\">\n    <!-- End block parameters -->\n    </mbr-parameters> \n\n    <div class=\"container\">\n        <div class=\"inner-container\" mbr-style=\"{'width': innerWidth + '%'}\">\n            <hr class=\"line\" mbr-style=\"{'width': lineLength + '%'}\">\n            <div class=\"section-text align-center mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".section-text\" mbr-text><div>&nbsp;&nbsp;&nbsp;&nbsp;Дробнич Иван Георгиевич родился в 1912 году в городе Николаеве в семье\n&nbsp;<span style=\"font-size: 1.2rem;\">путейского чиновника.&nbsp;</span></div><br><div>&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"font-size: 1.2rem;\">До войны Дробнич Иван Георгиевич работал механиком на Николаевском&nbsp;</span><span style=\"font-size: 1.2rem;\">судостроительном заводе имени Андре Марти, принимал участие в строительстве&nbsp;</span><span style=\"font-size: 1.2rem;\">ледокола «А. Микоян».&nbsp;</span></div><br><div>&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"font-size: 1.2rem;\">В 1941 году Дробнич И.Г. был мобилизован, стал краснофлотцем и вместе с&nbsp;</span><span style=\"font-size: 1.2rem;\">другими «николаевцами – судостроителями» продолжил службу матросом –</span><span style=\"font-size: 1.2rem;\">дизельным механиком на вспомогательном крейсере – ледоколе «Анастас&nbsp;</span><span style=\"font-size: 1.2rem;\">Микоян».&nbsp;</span></div><br><div>&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"font-size: 1.2rem;\">Осенью 1941 года дизельный механик краснофлотец Дробнич И.Г. в составе&nbsp;</span><span style=\"font-size: 1.2rem;\">экипажа вспомогательного крейсера - ледокола «Анастас Микоян» участвовал в обороне&nbsp;</span><span style=\"font-size: 1.2rem;\">Одессы, Севастополя и Новороссийска.&nbsp;</span></div><br><div>&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"font-size: 1.2rem;\">В 1941 – 1942 годах старшина 2 статьи дизельный механик Дробнич И.Г.&nbsp;</span><span style=\"font-size: 1.2rem;\">участвовал в кругосветном переходе ледокола «Анастас Микоян» из Чёрного моря&nbsp;</span><span style=\"font-size: 1.2rem;\">в Бухту Провидения (Анадырский залив, Берингово море).&nbsp;</span></div><br><div>&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"font-size: 1.2rem;\">Михаил Божаткин упоминает Ивана Дробнича в своей документальной повести&nbsp;</span><span style=\"font-size: 1.2rem;\">«Микоян» из цикла «Героические Корабли» как человека, прошедшего кругосветку,&nbsp;</span><span style=\"font-size: 1.2rem;\">и даже сыгравшего немаловажную роль при выводе корабля из горящего порта&nbsp;</span><span style=\"font-size: 1.2rem;\">Хайфы.&nbsp;</span></div><br><div>&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"font-size: 1.2rem;\">В августе 1942 года после расформирования экипажа ледокола «А. Микоян»&nbsp;</span><span style=\"font-size: 1.2rem;\">старшина 2 статьи Дробнич Иван Георгиевич остался служить на корабле.&nbsp;</span></div><br><div>&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"font-size: 1.2rem;\">В конце 1942 года на ледоколе «А. Микоян» Дробнич И.Г. встретился со своей&nbsp;</span><span style=\"font-size: 1.2rem;\">будущей женой, Марией Степановной, которая была призвана во флот в составе&nbsp;</span><span style=\"font-size: 1.2rem;\">женской группы краснофлотцев после расформирования основного экипажа&nbsp;</span></div><div>корабля.\n</div><br><div>&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"font-size: 1.2rem;\">В 1943 году в составе экипажа ремонтников Дробнич И.Г. и Мария Степановна&nbsp;</span><span style=\"font-size: 1.2rem;\">были в США на судостроительном - ремонтном заводе в Сиэтле, куда ледокол «Анастас Микоян»&nbsp;</span><span style=\"font-size: 1.2rem;\">был направлен на ремонт после взрыва на траверзе мыса Канин нос в&nbsp;</span><span style=\"font-size: 1.2rem;\">Белом море в ноябре 1942 года.</span></div><br><div>&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"font-size: 1.2rem;\">Будучи в США, они ходили в гости к друзьям американцам, рабочим&nbsp;</span><span style=\"font-size: 1.2rem;\">судостроительного завода, и их всегда очень хорошо принимали. После той&nbsp;</span><span style=\"font-size: 1.2rem;\">поездки в семье остались столовые приборы с буквами USA.&nbsp;</span></div><div>&nbsp;\n</div><div>&nbsp;&nbsp;&nbsp;&nbsp;После войны в город Николаев вернулась только Мария Степановна, а Иван&nbsp;<span style=\"font-size: 1.2rem;\">Георгиевич Дробнич И.Г. остался работать китобоем на Севере. В Николаев он&nbsp;</span><span style=\"font-size: 1.2rem;\">приезжал в отпуск.</span></div><br><div>&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"font-size: 1.2rem;\">В 1947 году в семье родился сын, Александр, который тоже впоследствии стал&nbsp;</span><span style=\"font-size: 1.2rem;\">моряком.</span></div><br><div>&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"font-size: 1.2rem;\">По свидетельству Марии Степановны, «на Севере Иван Георгиевич получал&nbsp;</span><span style=\"font-size: 1.2rem;\">хорошую северную зарплату и помогал семье».&nbsp;</span></div><br><div>&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"font-size: 1.2rem;\">В 1955 году Дробнич И.Г., как свидетельствует его внучка, «умер в море, там же&nbsp;</span><span style=\"font-size: 1.2rem;\">был и похоронен со всеми почестями по морскому обычаю — стоя, в саване и с&nbsp;</span><span style=\"font-size: 1.2rem;\">балластом в ногах».</span></div></div>\n            <hr class=\"line\" mbr-style=\"{'width': lineLength + '%'}\">\n        </div>\n        </div>\n</section>",
          "_cid": "rVkFVWlTIu",
          "_anchor": "content9-1mp",
          "_sourceTheme": "mobirise4",
