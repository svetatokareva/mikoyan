          "_name": "testimonials2",
          "_customHTML": "<section class=\"testimonials2\" group=\"Testimonials\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n      <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"8\">\n      <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"0\">\n\n      <input type=\"range\" inline title=\"Media Size\" name=\"mediaSize\" min=\"10\" max=\"200\" step=\"5\" value=\"130\">\n\n      <fieldset type=\"background\" name=\"bg\" parallax>\n          <input type=\"image\" title=\"Background Image\" value=\"../_images/background3.jpg\">\n          <input type=\"color\" title=\"Background Color\" value=\"#ffffff\" selected>\n          <input type=\"video\" title=\"Background Video\" value=\"http://www.youtube.com/watch?v=uNCr7NdOJgw\">\n      </fieldset>\n      <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n      <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#232323\" condition=\"overlay && bg.type !== 'color'\">\n      <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n    <!-- End block parameters --> \n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div class=\"container\">\n        <div class=\"media-container-row\">\n            <div class=\"mbr-figure pr-lg-5\" mbr-style=\"{'width':'50%'}\">\n              <img src=\"@PROJECT_PATH@/assets/images/1943-11-enhanced-510x676.jpeg\" alt title>\n            </div>\n            <div class=\"media-content px-3 align-self-center mbr-white py-2\">\n                    <p class=\"mbr-text testimonial-text mbr-fonts-style\" mbr-theme-style=\"display-1\" data-app-selector=\".testimonial-text\"><b>КАРЧЕНКОВ</b><br><b>Георгий (Юрий) Михайлович</b></p>\n                    <p class=\"mbr-author-name pt-4 mb-2 mbr-fonts-style\" mbr-theme-style=\"display-1\" data-app-selector=\".mbr-author-name\"><span style=\"font-weight: normal;font-size: 1.9rem;\">Лейтенант</span><br><span style=\"font-weight: normal;font-size: 1.9rem;\">Начальник интендантской службы ледокола<br></span><br><span style=\"font-weight: normal;\">1921 - ?</span><br></p>\n                    <p class=\"mbr-author-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-author-desc\"></p>\n            </div>\n        </div>\n    </div>\n</section>",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_cid": "rCWBvZewJd",
          "_anchor": "testimonials2-50",
          "_sourceTheme": "mobirise4",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "background-color": "@bgColor",
            ".line": {
              "background-color": "@lineColor",
              "color": "@lineColor",
              "align": "center",
              "height": "2px",
              "margin": "0 auto"
            },
            ".section-text": {
              "padding": "2rem 0",
              "text-align": "left"
            },
            ".inner-container": {
              "margin": "0 auto"
            },
            "@media (max-width: 768px)": {
              ".inner-container": {
                "width": "100% !important"
              }
            },
            ".section-text DIV": {
              "text-align": "left"
            }
          },
          "_name": "content9",
          "_customHTML": "<section class=\"mbr-section article content9\" group=\"Article\">\n    \n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"0\">\n        <input type=\"range\" inline title=\"Text Width\" name=\"innerWidth\" min=\"50\" max=\"100\" step=\"1\" value=\"100\">\n        <input type=\"range\" inline title=\"Line Width\" name=\"lineLength\" min=\"10\" max=\"100\" step=\"1\" value=\"25\">\n        <input type=\"color\" title=\"Line Color\" name=\"lineColor\" value=\"#149dcc\">\n        <input type=\"color\" title=\"Background Color\" name=\"bgColor\" value=\"#ffffff\">\n    <!-- End block parameters -->\n    </mbr-parameters> \n\n    <div class=\"container\">\n        <div class=\"inner-container\" mbr-style=\"{'width': innerWidth + '%'}\">\n            <hr class=\"line\" mbr-style=\"{'width': lineLength + '%'}\">\n            <div class=\"section-text align-center mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".section-text\" mbr-text><p>&nbsp; &nbsp;Карченков Георгий Михайлович родился 27 августа 1921 году в Кронштадте под Петроградом.\n<br></p><br><p>&nbsp; &nbsp; Карченков Г.М. был призван во флот в 1939 году из Петергофа.</p><br><p><span style=\"font-size: 1.2rem;\">&nbsp; &nbsp; Во время Великой Отечественной войны Карченков Г.М. служил начальником\n&nbsp;</span><span style=\"font-size: 1.2rem;\">интендантской службы на вспомогательном крейсере - ледоколе «Анастас&nbsp;</span><span style=\"font-size: 1.2rem;\">Микоян».</span><br></p><br><div>&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"font-size: 1.2rem;\">В составе экипажа корабля Карченков Г.М. участвовал в обороне Одессы и&nbsp;</span><span style=\"font-size: 1.2rem;\">Севастополя.&nbsp;</span></div><br><div>&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"font-size: 1.2rem;\">В 1941 – 1942 годах начальник интендантской службы ледокола Карченков Г.М.&nbsp;</span><span style=\"font-size: 1.2rem;\">участвовал в кругосветном переходе ледокола &nbsp;«Анастас Микоян» из Чёрного моря&nbsp;</span><span style=\"font-size: 1.2rem;\">в Бухту Провидения (Анадырский залив, Берингово море).&nbsp;</span></div><br><div>&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"font-size: 1.2rem;\">После войны Карченков Г.М. стал &nbsp;начальником снабжения Беломорской&nbsp;</span><span style=\"font-size: 1.2rem;\">Флотилии и вышел в отставку в апреле 1966 года в звании майора интендантской службы.</span></div><br><div><span style=\"font-size: 1.2rem;\">&nbsp; &nbsp;&nbsp;</span><span style=\"font-size: 1.2rem;\">В 1970-е годы Карченков Георгий Михайлович жил в Ленинграде.</span><br></div><p></p></div>\n            <hr class=\"line\" mbr-style=\"{'width': lineLength + '%'}\">\n        </div>\n        </div>\n</section>",
