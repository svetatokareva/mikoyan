          "_name": "testimonials2",
          "_customHTML": "<section class=\"testimonials2\" group=\"Testimonials\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n      <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"8\">\n      <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"0\">\n\n      <input type=\"range\" inline title=\"Media Size\" name=\"mediaSize\" min=\"10\" max=\"200\" step=\"5\" value=\"130\">\n\n      <fieldset type=\"background\" name=\"bg\" parallax>\n          <input type=\"image\" title=\"Background Image\" value=\"../_images/background3.jpg\">\n          <input type=\"color\" title=\"Background Color\" value=\"#ffffff\" selected>\n          <input type=\"video\" title=\"Background Video\" value=\"http://www.youtube.com/watch?v=uNCr7NdOJgw\">\n      </fieldset>\n      <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n      <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#232323\" condition=\"overlay && bg.type !== 'color'\">\n      <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n    <!-- End block parameters --> \n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div class=\"container\">\n        <div class=\"media-container-row\">\n            <div class=\"mbr-figure pr-lg-5\" mbr-style=\"{'width':'50%'}\">\n              <img src=\"@PROJECT_PATH@/assets/images/untitled2-3.jpeg\" alt title>\n            </div>\n            <div class=\"media-content px-3 align-self-center mbr-white py-2\">\n                    <p class=\"mbr-text testimonial-text mbr-fonts-style\" mbr-theme-style=\"display-1\" data-app-selector=\".testimonial-text\"><b>ЖИРОВ</b><br><b>Виктор Александрович</b></p>\n                    <p class=\"mbr-author-name pt-4 mb-2 mbr-fonts-style\" mbr-theme-style=\"display-1\" data-app-selector=\".mbr-author-name\"><span style=\"font-weight: normal;font-size: 1.9rem;\">Краснофлотец&nbsp;<br>Командир машинной группы<br></span><br><span style=\"font-weight: normal;\">1914 - ?</span><br></p>\n                    <p class=\"mbr-author-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-author-desc\"></p>\n            </div>\n        </div>\n    </div>\n</section>",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_cid": "rXe2Rzzj9P",
          "_anchor": "testimonials2-1op",
          "_sourceTheme": "mobirise4",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "background-color": "@bgColor",
            ".line": {
              "background-color": "@lineColor",
              "color": "@lineColor",
              "align": "center",
              "height": "2px",
              "margin": "0 auto"
            },
            ".section-text": {
              "padding": "2rem 0",
              "text-align": "left"
            },
            ".inner-container": {
              "margin": "0 auto"
            },
            "@media (max-width: 768px)": {
              ".inner-container": {
                "width": "100% !important"
              }
            },
            ".section-text DIV": {
              "text-align": "left"
            }
          },
          "_name": "content9",
          "_customHTML": "<section class=\"mbr-section article content9\" group=\"Article\">\n    \n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"0\">\n        <input type=\"range\" inline title=\"Text Width\" name=\"innerWidth\" min=\"50\" max=\"100\" step=\"1\" value=\"100\">\n        <input type=\"range\" inline title=\"Line Width\" name=\"lineLength\" min=\"10\" max=\"100\" step=\"1\" value=\"25\">\n        <input type=\"color\" title=\"Line Color\" name=\"lineColor\" value=\"#149dcc\">\n        <input type=\"color\" title=\"Background Color\" name=\"bgColor\" value=\"#ffffff\">\n    <!-- End block parameters -->\n    </mbr-parameters> \n\n    <div class=\"container\">\n        <div class=\"inner-container\" mbr-style=\"{'width': innerWidth + '%'}\">\n            <hr class=\"line\" mbr-style=\"{'width': lineLength + '%'}\">\n            <div class=\"section-text align-center mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".section-text\" mbr-text><div>&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"font-size: 1.2rem;\">Жиров Виктор Александрович родился в 1914 году.&nbsp;\n</span></div><br><div><span style=\"font-size: 1.2rem;\">&nbsp; &nbsp; В начале 1941 года отделом кадров ГУСМП (Главное управление Северного&nbsp;</span><span style=\"font-size: 1.2rem;\">морского пути) Жиров В.А. был назначен четвертым механиком и направлен в&nbsp;</span><span style=\"font-size: 1.2rem;\">город Николаев на судостроительный завод, где в это время строился новый&nbsp;</span></div><div><span style=\"font-size: 1.2rem;\">ледокол «Анастас Микоян».\n</span></div><br><div><span style=\"font-size: 1.2rem;\">&nbsp; &nbsp; В начале войны, летом 1941 года, Жиров В.А. был мобилизован и&nbsp;приписан к&nbsp;</span><span style=\"font-size: 1.2rem;\">команде вспомогательного крейсера «Анастас Микоян» в должности командира&nbsp;</span><span style=\"font-size: 1.2rem;\">машинной группы. &nbsp;&nbsp;</span></div><br><div><span style=\"font-size: 1.2rem;\">&nbsp; &nbsp; Осенью 1941 года краснофлотец Виктор Александрович Жиров в составе&nbsp;</span><span style=\"font-size: 1.2rem;\">экипажа вспомогательного крейсера «А. Микоян» участвовал в обороне Одессы,&nbsp;</span><span style=\"font-size: 1.2rem;\">Севастополя и Новороссийска.&nbsp;</span></div><br><div><span style=\"font-size: 1.2rem;\">&nbsp; &nbsp; После разоружения вспомогательного крейсера командир машинной группы&nbsp;</span><span style=\"font-size: 1.2rem;\">Жиров В.А. остался в составе экипажа ледокола «А. Микоян» и участвовал в&nbsp;</span><span style=\"font-size: 1.2rem;\">кругосветном переходе корабля из Чёрного моря в Бухту Провидения&nbsp;</span></div><div><span style=\"font-size: 1.2rem;\">(Анадырский залив, Берингово море).\n</span></div><br><div><span style=\"font-size: 1.2rem;\">&nbsp; &nbsp;В декабре 1942 года Жиров В.А. остался на ледоколе «А. Микоян» после&nbsp;</span><span style=\"font-size: 1.2rem;\">расформирования экипажа для прохождения дальнейшей службы.&nbsp;</span></div><br><div>&nbsp; &nbsp; Жиров В.А. б<span style=\"font-size: 1.2rem;\">ыл уволен в запас  в  январе 1943 года в звании техника – лейтенанта.</span></div><br><div><span style=\"font-size: 1.2rem;\">&nbsp; &nbsp; После войны Жиров В.А. проживал в городе Жданов.</span><br></div></div>\n            <hr class=\"line\" mbr-style=\"{'width': lineLength + '%'}\">\n        </div>\n        </div>\n</section>",
