            }
          },
          "_name": "testimonials2",
          "_customHTML": "<section class=\"testimonials2\" group=\"Testimonials\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n      <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"8\">\n      <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"0\">\n\n      <input type=\"range\" inline title=\"Media Size\" name=\"mediaSize\" min=\"10\" max=\"200\" step=\"5\" value=\"130\">\n\n      <fieldset type=\"background\" name=\"bg\" parallax>\n          <input type=\"image\" title=\"Background Image\" value=\"../_images/background3.jpg\">\n          <input type=\"color\" title=\"Background Color\" value=\"#ffffff\" selected>\n          <input type=\"video\" title=\"Background Video\" value=\"http://www.youtube.com/watch?v=uNCr7NdOJgw\">\n      </fieldset>\n      <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n      <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#232323\" condition=\"overlay && bg.type !== 'color'\">\n      <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n    <!-- End block parameters --> \n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div class=\"container\">\n        <div class=\"media-container-row\">\n            <div class=\"mbr-figure pr-lg-5\" mbr-style=\"{'width':'50%'}\">\n              <img src=\"@PROJECT_PATH@/assets/images/07459893-2-510x757.jpeg\" alt title>\n            </div>\n            <div class=\"media-content px-3 align-self-center mbr-white py-2\">\n                    <p class=\"mbr-text testimonial-text mbr-fonts-style\" mbr-theme-style=\"display-1\" data-app-selector=\".testimonial-text\"><b>КУЖЕЛЕВ</b><br><b>Виталий Иванович&nbsp;</b><br></p>\n                    <p class=\"mbr-author-name pt-4 mb-2 mbr-fonts-style\" mbr-theme-style=\"display-1\" data-app-selector=\".mbr-author-name\"><span style=\"font-weight: normal;font-size: 1.9rem;\">Старший краснофлотец&nbsp;<br>Комендор зенитный, моторист&nbsp;<br></span><br><span style=\"font-weight: normal;\">1921 - 1998</span><br></p>\n                    <p class=\"mbr-author-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-author-desc\"></p>\n            </div>\n        </div>\n    </div>\n</section>",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_cid": "rKiKeaEaIc",
          "_anchor": "testimonials2-xn",
          "_sourceTheme": "mobirise4",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "background-color": "@bgColor",
            ".line": {
              "background-color": "@lineColor",
              "color": "@lineColor",
              "align": "center",
              "height": "2px",
              "margin": "0 auto"
            },
            ".section-text": {
              "padding": "2rem 0",
              "text-align": "left"
            },
            ".inner-container": {
              "margin": "0 auto"
            },
            "@media (max-width: 768px)": {
              ".inner-container": {
                "width": "100% !important"
              }
            },
            ".section-text DIV": {
              "text-align": "left"
            }
          },
          "_name": "content9",
          "_customHTML": "<section class=\"mbr-section article content9\" group=\"Article\">\n    \n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"0\">\n        <input type=\"range\" inline title=\"Text Width\" name=\"innerWidth\" min=\"50\" max=\"100\" step=\"1\" value=\"100\">\n        <input type=\"range\" inline title=\"Line Width\" name=\"lineLength\" min=\"10\" max=\"100\" step=\"1\" value=\"25\">\n        <input type=\"color\" title=\"Line Color\" name=\"lineColor\" value=\"#149dcc\">\n        <input type=\"color\" title=\"Background Color\" name=\"bgColor\" value=\"#ffffff\">\n    <!-- End block parameters -->\n    </mbr-parameters> \n\n    <div class=\"container\">\n        <div class=\"inner-container\" mbr-style=\"{'width': innerWidth + '%'}\">\n            <hr class=\"line\" mbr-style=\"{'width': lineLength + '%'}\">\n            <div class=\"section-text align-center mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".section-text\" mbr-text><div><div>&nbsp; &nbsp; Кужелев Виталий Иванович родился 1 мая 1921 года в городе Аксай Ростовской\n&nbsp;<span style=\"font-size: 1.2rem;\">области.&nbsp;</span></div></div><br><div><div>&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"font-size: 1.2rem;\">Вскоре семья Кужелева В.И. переехала в Ростов-на-Дону, там Виталий окончил 4 класса&nbsp;</span><span style=\"font-size: 1.2rem;\">средней школы. В июле 1940 года Виталий Иванович был призван в армию. Ленинский районный&nbsp;</span><span style=\"font-size: 1.2rem;\">комиссариат направил красивого, рослого парня в Военно-Морской Флот.&nbsp;</span></div></div><br><div><div>&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"font-size: 1.2rem;\">Видимо, Кужелев В.И. начал службу на Балтийском флоте на строящемся ледоколе «Молотов», об этом свидетельствует его бескозырка на ранней фотографии.Но в начале войны Кужелев В.И. был переброшен с Балтики на Чёрное море.&nbsp;</span></div></div><br><div><div>&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"font-size: 1.2rem;\">В сентябре 1941 года Виталий прибыл на вспомогательный крейсер-ледокол «Анастас Микоян» комендором зенитчиком в звании Старший краснофлотец.&nbsp;</span></div></div><br><div><div>&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"font-size: 1.2rem;\">Осенью 1941 года в составе экипажа вспомогательного крейсера «А. Микоян»&nbsp;</span><span style=\"font-size: 1.2rem;\">Виталий Иванович Кужелев участвовал в обороне Одессы и Севастополя.&nbsp;</span></div></div><br><div><div>&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"font-size: 1.2rem;\">В 1941 – 1942 годах старший краснофлотец Кужелев В.И. участвовал в кругосветном переходе ледокола «Анастас Микоян» из Чёрного моря в Бухту Провидения (Анадырский залив, Берингово море).&nbsp;</span></div></div><br><div><div>&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"font-size: 1.2rem;\">В 1942 – 1945 годах Кужелев В.И. продолжил службу на ледоколе «А.Микоян», работал в Арктике и на дальнем Востоке, ледокол «А. Микоян» обеспечивал доставку необходимых фронту грузов по Северному Морскому пути.&nbsp;</span></div></div><br><div><div><span style=\"font-size: 1.2rem;\">&nbsp; &nbsp; В 1945 году Виталий Кужелев был переведен во Владивосток. Началась война с Японией. Моряки были готовы и дальше сражаться за Родину, но Япония капитулировала. В.И. Кужелев еще два года охранял морские рубежи страны в Японском море. </span></div></div><br><div><div>&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"font-size: 1.2rem;\">В 1947 году Виталий Иванович Кужелев был демобилизован и решил возвратиться в город Ростов-на-Дону. Но друзья по экипажу предложили ему поехать вместе на восстановление Сталинграда. Ведь моряк был еще и хорошим шофером.&nbsp;</span><span style=\"font-size: 1.2rem;\">Сталинград стал для В.И. Кужелева судьбоносным городом. Там он встретил подругу жизни Мидту Хаджимуратовну. Они поженились и прожили в любви и согласии 47 лет. &nbsp;</span></div><br><div>&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"font-size: 1.2rem;\">Кужелев В.И. вместе с женой восстанавливал Сталинград, работал на строительстве Цимлянского гидроузла. В 1949 году, после завершения стройки,В.И. Кужелев работал водителем в АК-2070 («Автоколонна 2017») в городе Волгодонске. &nbsp;&nbsp;</span></div><br><div>&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"font-size: 1.2rem;\">Здесь же, в Волгодонске, родились их дочери - Евгения, Наталья, Татьяна.&nbsp;</span></div><br><div>&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"font-size: 1.2rem;\">В 1980 году Кужелев В.И. вышел на пенсию.&nbsp;</span></div><br><div>&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"font-size: 1.2rem;\">Умер Виталий Иванович Кужелев 18 июня 1998 года.</span></div></div>\n            <hr class=\"line\" mbr-style=\"{'width': lineLength + '%'}\">\n        </div>\n        </div></div></section>",
          "_cid": "rKiKeb3u4R",
