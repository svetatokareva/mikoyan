        {
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "H1": {
              "color": "#ffffff",
              "text-align": "center"
            },
            ".mbr-text, .mbr-section-btn": {
              "color": "#ffffff",
              "text-align": "center"
            }
          },
          "_name": "header2",
          "_customHTML": "<section group=\"Headers\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n         'mbr-fullscreen': fullScreen,\n         'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"6\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"6\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Show Arrow\" name=\"showArrow\" checked>\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Subtitle\" name=\"showSubTitle\">\n        <input type=\"checkbox\" title=\"Show Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Show Buttons\" name=\"showButtons\">\n\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"@PROJECT_PATH@/assets/images/sergeev-7-2000x1282.jpeg\" selected>\n            <input type=\"color\" title=\"Background Color\" value=\"#073B4C\">\n            <input type=\"video\" title=\"Background Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#767676\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div class=\"container align-center\">\n        <div class=\"row justify-content-md-center\">\n            <div class=\"mbr-white col-md-10\">\n                <h1 class=\"mbr-section-title mbr-bold pb-3 mbr-fonts-style\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle\"><br>Кругосветный переход <br>ледокола \"Микоян\"&nbsp;1941-1942</h1>\n                <h3 class=\"mbr-section-subtitle align-center mbr-light pb-3 mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showSubTitle\">\n                    Beautiful mobile websites\n                </h3>\n                <p class=\"mbr-text pb-3 mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\"><b>&nbsp;</b><br><br><br><b>В разгар Второй Мировой Войны <br>советский безоружный корабль <br>пересек двенадцать морей и <br>четыре&nbsp;океана,&nbsp;прорвавшись <br>через&nbsp;воды,&nbsp;контролируемые <br>странами&nbsp;\"Оси\". </b><br></p>\n                <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-md btn-secondary\" href=\"https://mobirise.com\" data-app-placeholder=\"Type Text\">LEARN MORE</a>\n                    <a class=\"btn btn-md btn-white-outline\" href=\"https://mobirise.com\" data-app-placeholder=\"Type Text\">LIVE DEMO</a></div>\n            </div>\n        </div>\n    </div>\n    <div mbr-if=\"showArrow\" class=\"mbr-arrow hidden-sm-down\" aria-hidden=\"true\">\n        <a href=\"#next\">\n            <i class=\"mbri-down mbr-iconfont\"></i>\n        </a>\n    </div>\n</section>",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_sourceTheme": "mobirise4",
          "_cid": "tDri78jz9w",
          "_anchor": "header2-23k",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "background-color": "@bgColor",
            ".mbr-text, blockquote": {
              "color": "#767676"
            },
            ".mbr-text P": {
              "text-align": "right"
            }
          },
          "_name": "content1",
          "_customHTML": "<section class=\"mbr-section article content1\">\n    \n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"8\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"0\">\n        <input type=\"range\" inline title=\"Width Content\" name=\"widthContent\" min=\"1\" max=\"4\" step=\"1\" value=\"4\">\n        <input type=\"color\" title=\"Background Color\" name=\"bgColor\" value=\"#ffffff\">\n    <!-- End block parameters -->\n    </mbr-parameters> \n\n    <div class=\"container\">\n        <div class=\"media-container-row\">\n            <div class=\"mbr-text col-12 mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\" data-multiline mbr-article mbr-class=\"{'col-md-6': widthContent == 1, 'col-md-8': widthContent == 2, 'col-md-10': widthContent == 3, 'col-md-12': widthContent == 4}\"><p><i>«Корабли, как и люди, имеют свою биографию, свою судьбу. </i></p><p><i>И нередко корабль входит в жизнь моряка так, что они </i></p><p><i>немыслимы друг без друга» \n</i></p><p><i>(Э. Безуглов).\n</i></p></div>\n        </div>\n    </div>\n</section>",
          "_sourceTheme": "mobirise4",
          "_cid": "tDri78UpLQ",
          "_anchor": "content1-23l",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "background-color": "@bgColor",
            ".mbr-text, blockquote": {
              "color": "#767676"
            }
          },
          "_name": "content1",
          "_customHTML": "<section class=\"mbr-section article content1\">\n    \n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"1\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"1\">\n        <input type=\"range\" inline title=\"Width Content\" name=\"widthContent\" min=\"1\" max=\"4\" step=\"1\" value=\"4\">\n        <input type=\"color\" title=\"Background Color\" name=\"bgColor\" value=\"#ffffff\">\n    <!-- End block parameters -->\n    </mbr-parameters> \n\n    <div class=\"container\">\n        <div class=\"media-container-row\">\n            <div class=\"mbr-text col-12 mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\" data-multiline mbr-article mbr-class=\"{'col-md-6': widthContent == 1, 'col-md-8': widthContent == 2, 'col-md-10': widthContent == 3, 'col-md-12': widthContent == 4}\"><p>&nbsp; &nbsp;Мы посвящаем этот сайт героическому экипажу линейного ледокола «Анастас Микоян» и их общему подвигу в годы Великой Отечественной войны. Они сами называли себя «Микояновцы».\n</p><p>&nbsp; &nbsp;Ледокол «Анастас Микоян» сошел со стапелей в городе Николаеве в августе 1941 года. Он был вооружён и превращён во вспомогательный крейсер Черноморского флота; воевал, защищая Одессу и Севастополь в самом начале войны (август, сентябрь, октябрь 1941 года).\n</p><p>&nbsp; &nbsp;В ноябре 1941 года в соответствии с решением Государственного комитета обороны поступил приказ перейти в порт Поти, разоружить корабль и готовиться к переходу из Чёрного моря на дальний Восток через Босфор. Страна остро нуждалась в ледоколах в Арктике для доставки военных грузов. Статус Турции предусматривал возможность прохода через проливы только гражданским (невооруженным) судам. У капитана ледокола имелся приказ: «Корабль ни в коем случае не сдавать, взрывом топить, экипажу в плен не сдаваться». Это был потенциальный «Варяг», и об этом приказе знал весь экипаж. Но «Микояновцы» были готовы выполнить приказ Родины любой ценой, даже безоружными прорваться через все преграды и прийти в Бухту Провидения. И они дошли, сохранив команду и корабль.\n</p><p>&nbsp; &nbsp;Вспомогательный крейсер «Анастас Микоян» был разоружён за пять дней, вновь превращён в ледокол и под государственным флагом СССР вышел из Батуми, прошёл проливы Босфор и Дарданеллы, вышел в Эгейское море, принял неравный бой с итало-фашистами у острова Родос, пришёл в Хайфу, вступил в порту Хайфы в бой с огненной стихией и победил её. Экипаж ледокола спас от огня не только свой корабль, но и растерявшихся британских моряков. Затем ледокол, пройдя через Суэцкий канал и через 3 океана – Индийский, Атлантический и Тихий, – через восемь с половиной месяцев благополучно прибыл в Берингово море, Анадырский залив, Бухту Провидения (9 августа 1942 года). Все 165 моряков, членов экипажа ледокола «Микоян», были целы и невредимы. \n</p><p>&nbsp; &nbsp;В истории советского Военно-Морского флота это было единственное кругосветное плавание (кроме атомных подводных лодок), и было оно совершенно во время войны в 1941-1942 гг. черноморским вспомогательным крейсером легендарным ледоколом «Анастас Микоян» под командованием капитана 2 ранга С.М. Сергеева.\n</p><p>&nbsp; &nbsp;До 1958 года все документы, связанные с беспрецедентным «кругосветным» переходом Советского ледокола «Анастас Микоян»» из Чёрного моря в Берингово море, из порта Батуми на Дальний Восток, были засекречены. Весь экипаж корабля дал подписку «о неразглашении», и вместо орденов и медалей моряки получили памятный жетон «За дальний поход».\n</p><p>&nbsp; &nbsp;Мы хотим всех моряков «Микояновцев» поимённо назвать, рассказать не только о судьбе легендарного корабля и знаменитой «огненной кругосветке», но и о судьбе каждого моряка - от капитана корабля до матроса-кочегара. Ибо общий подвиг, ставший общей судьбой корабля, был возможен только потому, что каждый в отдельности был готов выполнить свою тяжёлую и славную морскую работу, – «Не до ордена. Была бы родина с ежедневными Бородино!» (М.В. Кульчицкий)\n</p><p>&nbsp; &nbsp;Мы хотим исполнить свой долг Памяти перед нашими предками. Мы не хотим, чтобы они, преодолев Пространства трёх океанов, потонули в Океане Времени! Мы приглашаем всех, кому не безразлична судьба «Микояновцев» и легендарного ледокола «Анастас Микоян», принять участие в нашем «Общем деле» - «Воскрешении наших отцов»!</p></div>\n        </div>\n    </div>\n</section>",
          "_sourceTheme": "mobirise4",
