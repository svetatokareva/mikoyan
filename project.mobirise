            "background-color": "@bgColor",
            ".line": {
              "background-color": "@lineColor",
              "color": "@lineColor",
              "align": "center",
              "height": "2px",
              "margin": "0 auto"
            },
            ".section-text": {
              "padding": "2rem 0",
              "text-align": "left"
            },
            ".inner-container": {
              "margin": "0 auto"
            },
            "@media (max-width: 768px)": {
              ".inner-container": {
                "width": "100% !important"
              }
            },
            ".section-text DIV": {
              "text-align": "left"
            }
          },
          "_name": "content9",
          "_customHTML": "<section class=\"mbr-section article content9\" group=\"Article\">\n    \n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"0\">\n        <input type=\"range\" inline title=\"Text Width\" name=\"innerWidth\" min=\"50\" max=\"100\" step=\"1\" value=\"100\">\n        <input type=\"range\" inline title=\"Line Width\" name=\"lineLength\" min=\"10\" max=\"100\" step=\"1\" value=\"25\">\n        <input type=\"color\" title=\"Line Color\" name=\"lineColor\" value=\"#149dcc\">\n        <input type=\"color\" title=\"Background Color\" name=\"bgColor\" value=\"#ffffff\">\n    <!-- End block parameters -->\n    </mbr-parameters> \n\n    <div class=\"container\">\n        <div class=\"inner-container\" mbr-style=\"{'width': innerWidth + '%'}\">\n            <hr class=\"line\" mbr-style=\"{'width': lineLength + '%'}\">\n            <div class=\"section-text align-center mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".section-text\" mbr-text><p>&nbsp;&nbsp;&nbsp;&nbsp;Григорий Ефимович Чеснок родился в 1912 году.\n</p><div>\n</div><div>&nbsp; &nbsp; В 1941 году краснофлотец Чеснок Г.Е. был приписан к вспомогательному\n&nbsp;<span style=\"font-size: 1.2rem;\">крейсеру «Анастас Микоян». </span></div><br><div>&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"font-size: 1.2rem;\">В составе экипажа вспомогательного крейсера «А.&nbsp;</span><span style=\"font-size: 1.2rem;\">Микоян» Чеснок Г.Е. участвовал в обороне Одессы, Севастополя и&nbsp;</span></div><div>Новороссийска.</div><br><div>\n</div><div>\n</div><div>&nbsp; &nbsp; В 1941 – 1942 годах рулевой Чеснок Г.Е. участвовал в кругосветном переходе\n&nbsp;<span style=\"font-size: 1.2rem;\">ледокола «Анастас Микоян» из Чёрного моря в Бухту Провидения (Анадырский&nbsp;</span><span style=\"font-size: 1.2rem;\">залив, Берингово море). &nbsp;&nbsp;</span></div><br><div><span style=\"font-size: 1.2rem;\">&nbsp; &nbsp; Чеснок Г.Е. покинул ледокол «Микоян» при расформировании экипажа в\n&nbsp;</span><span style=\"font-size: 1.2rem;\">декабре 1942 года.&nbsp;</span></div><br><div><span style=\"font-size: 1.2rem;\">&nbsp; &nbsp; Дальнейшая судьба Григория Ефимовича неизвестна.</span><br></div><p></p></div>\n            <hr class=\"line\" mbr-style=\"{'width': lineLength + '%'}\">\n        </div>\n        </div>\n</section>",
          "_cid": "rXdVYXNxFU",
