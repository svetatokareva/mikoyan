            }
          },
          "_name": "testimonials2",
          "_customHTML": "<section class=\"testimonials2\" group=\"Testimonials\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n      <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"8\">\n      <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"0\">\n\n      <input type=\"range\" inline title=\"Media Size\" name=\"mediaSize\" min=\"10\" max=\"200\" step=\"5\" value=\"130\">\n\n      <fieldset type=\"background\" name=\"bg\" parallax>\n          <input type=\"image\" title=\"Background Image\" value=\"../_images/background3.jpg\">\n          <input type=\"color\" title=\"Background Color\" value=\"#ffffff\" selected>\n          <input type=\"video\" title=\"Background Video\" value=\"http://www.youtube.com/watch?v=uNCr7NdOJgw\">\n      </fieldset>\n      <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n      <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#232323\" condition=\"overlay && bg.type !== 'color'\">\n      <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n    <!-- End block parameters --> \n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div class=\"container\">\n        <div class=\"media-container-row\">\n            <div class=\"mbr-figure pr-lg-5\" mbr-style=\"{'width':'50%'}\">\n              <img src=\"@PROJECT_PATH@/assets/images/img026-5-1761x2611.jpg\" alt title>\n            </div>\n            <div class=\"media-content px-3 align-self-center mbr-white py-2\">\n                    <p class=\"mbr-text testimonial-text mbr-fonts-style\" mbr-theme-style=\"display-1\" data-app-selector=\".testimonial-text\"><b>ГОЛУБКОВ <br>Алексей Ионович</b><br></p>\n                    <p class=\"mbr-author-name pt-4 mb-2 mbr-fonts-style\" mbr-theme-style=\"display-1\" data-app-selector=\".mbr-author-name\"><span style=\"font-weight: normal;font-size: 1.9rem;\">Краснофлотец<br>Командир группы машинистов<br></span><br><span style=\"font-weight: normal;\">1918 - 1994</span><br></p>\n                    <p class=\"mbr-author-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-author-desc\"></p>\n            </div>\n        </div>\n    </div>\n</section>",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_cid": "rBa35YvesQ",
          "_anchor": "testimonials2-1l",
          "_sourceTheme": "mobirise4",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "background-color": "@bgColor",
            ".line": {
              "background-color": "@lineColor",
              "color": "@lineColor",
              "align": "center",
              "height": "2px",
              "margin": "0 auto"
            },
            ".section-text": {
              "padding": "2rem 0",
              "text-align": "left"
            },
            ".inner-container": {
              "margin": "0 auto"
            },
            "@media (max-width: 768px)": {
              ".inner-container": {
                "width": "100% !important"
              }
            },
            ".section-text DIV": {
              "text-align": "left"
            }
          },
          "_name": "content9",
          "_customHTML": "<section class=\"mbr-section article content9\" group=\"Article\">\n    \n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"0\">\n        <input type=\"range\" inline title=\"Text Width\" name=\"innerWidth\" min=\"50\" max=\"100\" step=\"1\" value=\"100\">\n        <input type=\"range\" inline title=\"Line Width\" name=\"lineLength\" min=\"10\" max=\"100\" step=\"1\" value=\"25\">\n        <input type=\"color\" title=\"Line Color\" name=\"lineColor\" value=\"#149dcc\">\n        <input type=\"color\" title=\"Background Color\" name=\"bgColor\" value=\"#ffffff\">\n    <!-- End block parameters -->\n    </mbr-parameters> \n\n    <div class=\"container\">\n        <div class=\"inner-container\" mbr-style=\"{'width': innerWidth + '%'}\">\n            <hr class=\"line\" mbr-style=\"{'width': lineLength + '%'}\">\n            <div class=\"section-text align-center mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".section-text\" mbr-text><div><br></div><div>&nbsp; &nbsp;Голубков Алексей Ионович родился в семье крестьянина в селе Зашугомье Костромской области в 1918 году. Окончил ремесленное училище в городе Ярославле и получил специальность слесаря.</div><div><br></div><div><span style=\"font-size: 1.2rem;\">&nbsp; &nbsp;С 1937 года до 1939 года работал слесарем шинного завода в городе Ярославле на резино-асбестовом комбинате.</span></div><br><div><span style=\"font-size: 1.2rem;\"> </span></div><div><span style=\"font-size: 1.2rem;\">&nbsp; &nbsp;В 1939 году был призван во флот и сразу был рекомендован на учёбу в военно-морское училище, готовившее морских офицеров-электротехников в городе Севастополе, но окончить училище Голубков А.И. не успел, так как началась война. &nbsp;</span></div><br><div><span style=\"font-size: 1.2rem;\">&nbsp; &nbsp;В 1941 году служил матросом на вспомогательном крейсере - ледоколе «Анастас Микоян», участвовал в обороне Одессы и Севастополя. В 1941- 1942 годах участвовал в кругосветном походе ледокола «Анастас Микоян» из Чёрного моря в Анадырский залив Берингова моря. &nbsp;</span></div><br><div><span style=\"font-size: 1.2rem;\">&nbsp; &nbsp;В дальнейшем являлся командиром отделения зенитных комендоров (артиллеристов) ледокола «Северный ветер» ГУСМП при СНК СССР в звании старшины 2-й статьи.&nbsp;</span><br></div><br><div><span style=\"font-size: 1.2rem;\">&nbsp; &nbsp;В 1945 году стал членом ВКПб .</span><br></div><br><div><span style=\"font-size: 1.2rem;\">&nbsp; &nbsp;После войны ходил на тральщиках, очищая прибрежные воды от мин. \n</span><span style=\"font-size: 1.2rem;\">&nbsp;</span><span style=\"font-size: 1.2rem;\">Был демобилизован в 1946 году в звании старшины 1-й статьи.&nbsp;</span><span style=\"font-size: 1.2rem;\">Демобилизовавшись из ВМФ, в 1946-1948 годах служил на ледоколах, но по состоянию здоровья был списан на берег. &nbsp;</span><span style=\"font-size: 1.2rem;\">&nbsp; &nbsp;&nbsp;</span><br><span style=\"font-size: 1.2rem;\"></span></div><div>&nbsp;</div><div>&nbsp;&nbsp;&nbsp;&nbsp;С 1948 года трудился прорабом в Ленинградском монтажном управлении треста «Севзапмонтажавтоматика» в городе Ленинграде. \n</div><div><span style=\"font-size: 1.2rem;\">&nbsp;</span></div><div>&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"font-size: 1.2rem;\">Участвовал в строительстве атомного ледокола «Ленин» на Адмиралтейском судостроительном заводе в должности сдаточного механика.</span></div><div><span style=\"font-size: 1.2rem;\"><br></span>&nbsp; &nbsp;&nbsp;<span style=\"font-size: 1.2rem;\">Работал на реконструкции и переоснащении ленинградских заводов.&nbsp;</span></div><div><span style=\"font-size: 1.2rem;\">&nbsp; &nbsp;</span></div><div>&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"font-size: 1.2rem;\">В 1966 году Голубкову Алексею Ионовичу было присвоено звание Героя Социалистического Труда. &nbsp;</span></div><div>&nbsp; &nbsp;\n</div><div>&nbsp;&nbsp;&nbsp;&nbsp;В 1972 году вышел на пенсию, но продолжал трудиться, работал механиком в НПО «Ленсистемотехника».</div><br><div>&nbsp; &nbsp;&nbsp;<span style=\"font-size: 1.2rem;\">Ушёл из жизни в 1994 году. Похоронен на Волковском кладбище в Ленинграде</span></div></div>\n            <hr class=\"line\" mbr-style=\"{'width': lineLength + '%'}\">\n        </div>\n        </div>\n</section>",
          "_cid": "rBa35Z9TMz",
          "_anchor": "content9-1m",
          "_sourceTheme": "mobirise4",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
