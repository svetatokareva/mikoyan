            }
          },
          "_name": "testimonials2",
          "_customHTML": "<section class=\"testimonials2\" group=\"Testimonials\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n      <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"8\">\n      <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"0\">\n\n      <input type=\"range\" inline title=\"Media Size\" name=\"mediaSize\" min=\"10\" max=\"200\" step=\"5\" value=\"130\">\n\n      <fieldset type=\"background\" name=\"bg\" parallax>\n          <input type=\"image\" title=\"Background Image\" value=\"../_images/background3.jpg\">\n          <input type=\"color\" title=\"Background Color\" value=\"#ffffff\" selected>\n          <input type=\"video\" title=\"Background Video\" value=\"http://www.youtube.com/watch?v=uNCr7NdOJgw\">\n      </fieldset>\n      <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n      <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#232323\" condition=\"overlay && bg.type !== 'color'\">\n      <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n    <!-- End block parameters --> \n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div class=\"container\">\n        <div class=\"media-container-row\">\n            <div class=\"mbr-figure pr-lg-5\" mbr-style=\"{'width':'50%'}\">\n              <img src=\"@PROJECT_PATH@/assets/images/510x699.jpeg\" alt title>\n            </div>\n            <div class=\"media-content px-3 align-self-center mbr-white py-2\">\n                    <p class=\"mbr-text testimonial-text mbr-fonts-style\" mbr-theme-style=\"display-1\" data-app-selector=\".testimonial-text\"><b>НИКИТИН </b><br><b>Иван Петрович</b><br></p>\n                    <p class=\"mbr-author-name pt-4 mb-2 mbr-fonts-style\" mbr-theme-style=\"display-1\" data-app-selector=\".mbr-author-name\"><span style=\"font-weight: normal;font-size: 1.9rem;\">Старший Лейтенант\n<br>Второй помощник капитана<br></span><br><span style=\"font-weight: normal;\">1910 - ?</span><br></p>\n                    <p class=\"mbr-author-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-author-desc\"></p>\n            </div>\n        </div>\n    </div>\n</section>",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_cid": "rKiPlxqwDx",
          "_anchor": "testimonials2-xt",
          "_sourceTheme": "mobirise4",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "background-color": "@bgColor",
            ".line": {
              "background-color": "@lineColor",
              "color": "@lineColor",
              "align": "center",
              "height": "2px",
              "margin": "0 auto"
            },
            ".section-text": {
              "padding": "2rem 0",
              "text-align": "left"
            },
            ".inner-container": {
              "margin": "0 auto"
            },
            "@media (max-width: 768px)": {
              ".inner-container": {
                "width": "100% !important"
              }
            },
            ".section-text DIV": {
              "text-align": "left"
            }
          },
          "_name": "content9",
          "_customHTML": "<section class=\"mbr-section article content9\" group=\"Article\">\n    \n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"0\">\n        <input type=\"range\" inline title=\"Text Width\" name=\"innerWidth\" min=\"50\" max=\"100\" step=\"1\" value=\"100\">\n        <input type=\"range\" inline title=\"Line Width\" name=\"lineLength\" min=\"10\" max=\"100\" step=\"1\" value=\"25\">\n        <input type=\"color\" title=\"Line Color\" name=\"lineColor\" value=\"#149dcc\">\n        <input type=\"color\" title=\"Background Color\" name=\"bgColor\" value=\"#ffffff\">\n    <!-- End block parameters -->\n    </mbr-parameters> \n\n    <div class=\"container\">\n        <div class=\"inner-container\" mbr-style=\"{'width': innerWidth + '%'}\">\n            <hr class=\"line\" mbr-style=\"{'width': lineLength + '%'}\">\n            <div class=\"section-text align-center mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".section-text\" mbr-text><p></p><div>&nbsp; &nbsp;&nbsp; &nbsp; Никитин Иван Петрович родился 16 июня 1910 года в селе Выгозеро в Карелии. Отец его был портным, мать - домохозяйкой. Отец мальчика умер, когда ему едва исполнилось 14 лет.</div><br><div>&nbsp; &nbsp; В 1924 году Иван Петрович окончил пять классов школы на станции Сичино Кировской железной дороги. Затем он работал разнорабочим (грузчиком, сплавщиком, рабочим, десятником) на Кировской железной дороге.</div>&nbsp; &nbsp;<p></p><p>&nbsp;&nbsp;&nbsp;&nbsp;В 1930 году Никитин И. П. окончил курсы лесных десятников в Петрозаводске и затем работал десятником на Кировской железной дороге до 1932 года.</p><p></p><div>&nbsp; &nbsp; В 1933 году Никитин И. П. был призван во флот и окончил учебный отряд подводного плавания по классу торпедистов в Ленинграде.<br></div><br><div>&nbsp; &nbsp; С 1933 по 1936 Никитин И. П. служил командиром отделения Первой Бригады Подводных Лодок К. Б. Ф.<br></div><br><div>&nbsp; &nbsp;  В 1936 году Никитин И. П. остался во флоте на сверхсрочную службу. Служил старшиной группы торпедистов Второй Бригады Подводных Лодок К. Б. Ф.<br></div><br><div>&nbsp; &nbsp; В 1937 году окончил шестимесячные курсы политруков при Политуправлении Краснознаменного Балтийского Флота&nbsp; (ПУБалт) в Кронштадте, после чего служил политруком первой и второй башни линейного корабля \"Марат\" К. Б. Ф.<br></div><br><div>&nbsp;&nbsp;&nbsp;&nbsp;В 1941 – 1942 годах старший лейтенант Никитин Иван Петрович в должности\n второго помощника капитана участвовал в кругосветном переходе ледокола Анастас Микоян\" из Чёрного моря в Бухту Проведения (Анадырский залив,Берингово море).<br></div><br><div>&nbsp; &nbsp; Еще до войны Никитин И. П. женился и у него родился сын Борис в 1937 году.<br></div><br><div>\n</div><div>\n</div><div>&nbsp;&nbsp;&nbsp;&nbsp;К сожалению, дальнейшие следы Никитина И. П. теряются.</div><p></p></div>\n            <hr class=\"line\" mbr-style=\"{'width': lineLength + '%'}\">\n        </div>\n        </div>\n</section>",
