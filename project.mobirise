                "thumb": "@PROJECT_PATH@/assets/images/17-1976-2000x2737-800x1095.jpg",
                "alt": "",
                "title": "",
                "customStyle1": "display-7",
                "caption": "Type caption here",
                "active": true
              }
            ]
          }
