          "_name": "testimonials2",
          "_customHTML": "<section class=\"testimonials2\" group=\"Testimonials\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n      <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"8\">\n      <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"0\">\n\n      <input type=\"range\" inline title=\"Media Size\" name=\"mediaSize\" min=\"10\" max=\"200\" step=\"5\" value=\"130\">\n\n      <fieldset type=\"background\" name=\"bg\" parallax>\n          <input type=\"image\" title=\"Background Image\" value=\"../_images/background3.jpg\">\n          <input type=\"color\" title=\"Background Color\" value=\"#ffffff\" selected>\n          <input type=\"video\" title=\"Background Video\" value=\"http://www.youtube.com/watch?v=uNCr7NdOJgw\">\n      </fieldset>\n      <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n      <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#232323\" condition=\"overlay && bg.type !== 'color'\">\n      <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n    <!-- End block parameters --> \n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div class=\"container\">\n        <div class=\"media-container-row\">\n            <div class=\"mbr-figure pr-lg-5\" mbr-style=\"{'width':'50%'}\">\n              <img src=\"@PROJECT_PATH@/assets/images/groysman-1.jpeg\" alt title>\n            </div>\n            <div class=\"media-content px-3 align-self-center mbr-white py-2\">\n                    <p class=\"mbr-text testimonial-text mbr-fonts-style\" mbr-theme-style=\"display-1\" data-app-selector=\".testimonial-text\"><b>ГРОЙСМАН <br>Александр Давыдович\n</b><br></p>\n                    <p class=\"mbr-author-name pt-4 mb-2 mbr-fonts-style\" mbr-theme-style=\"display-1\" data-app-selector=\".mbr-author-name\"><span style=\"font-weight: normal;font-size: 1.9rem;\">Мичман\n<br>Старший боцман<br></span><br><span style=\"font-weight: normal;\">1909 - 1982</span><br></p>\n                    <p class=\"mbr-author-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-author-desc\"></p>\n            </div>\n        </div>\n    </div>\n</section>",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_cid": "rB9zWIlyTU",
          "_anchor": "testimonials2-1v",
          "_sourceTheme": "mobirise4",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "background-color": "@bgColor",
            ".line": {
              "background-color": "@lineColor",
              "color": "@lineColor",
              "align": "center",
              "height": "2px",
              "margin": "0 auto"
            },
            ".section-text": {
              "padding": "2rem 0",
              "text-align": "left"
            },
            ".inner-container": {
              "margin": "0 auto"
            },
            "@media (max-width: 768px)": {
              ".inner-container": {
                "width": "100% !important"
              }
            },
            ".section-text DIV": {
              "text-align": "left"
            }
          },
          "_name": "content9",
          "_customHTML": "<section class=\"mbr-section article content9\" group=\"Article\">\n    \n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"0\">\n        <input type=\"range\" inline title=\"Text Width\" name=\"innerWidth\" min=\"50\" max=\"100\" step=\"1\" value=\"100\">\n        <input type=\"range\" inline title=\"Line Width\" name=\"lineLength\" min=\"10\" max=\"100\" step=\"1\" value=\"25\">\n        <input type=\"color\" title=\"Line Color\" name=\"lineColor\" value=\"#149dcc\">\n        <input type=\"color\" title=\"Background Color\" name=\"bgColor\" value=\"#ffffff\">\n    <!-- End block parameters -->\n    </mbr-parameters> \n\n    <div class=\"container\">\n        <div class=\"inner-container\" mbr-style=\"{'width': innerWidth + '%'}\">\n            <hr class=\"line\" mbr-style=\"{'width': lineLength + '%'}\">\n            <div class=\"section-text align-center mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".section-text\" mbr-text><div>&nbsp; &nbsp;Александр Давыдович Гройсман родился 5 декабря 1909 года в городе Николаеве.\n<br></div><div><br></div><div>&nbsp; &nbsp;В 17 лет начал работать на Николаевском судостроительном заводе имени Андре Марти.\n</div><div><br></div><div>&nbsp; &nbsp;В 1928 году Гройсман А.Д. был призван во флот.\n&nbsp;<span style=\"font-size: 1.2rem;\">«Службу начал на линкоре «Парижская коммуна», вместе с этим кораблём в штормовую зиму с 1929 на 1930 год совершил переход из Балтийского в Чёрное море» (Божаткин М.)&nbsp;</span></div><div><br></div><div>&nbsp; &nbsp;В 1931 году Гройсман А. Д. поступил в школу боцманов в городе Севастополе. После окончания ходил на линкорах «Профинтерн» и «Красный Кавказ». Стал главным боцманом линкора «Парижская коммуна»</div><br><div>\n</div><div>\n</div><div>&nbsp; &nbsp;В 1941 году, в самом начале Великой Отечественной войны, Гройсман А. Д. был откомандирован в город Николаев, где на судостроительном заводе готовился к спуску ледокол «Анастас Микоян».</div><br><div> \n</div><div>В кротчайшие сроки ледокол был переоборудован во вспомогательный крейсер.</div><br><div>\n</div><div>Мичман Гройсман А.Д. был назначен главным боцманом на крейсер-ледокол «Анастас Микоян».</div><br><div>\n</div><div>\n</div><div>&nbsp; &nbsp;В составе экипажа мичман Гройсман А.Д. принимал участие в обороне Одессы, а затем и Севастополя.</div><br><div> \n</div><div>\n</div><div>&nbsp; &nbsp;В 1941 – 1942 годах старший боцман Гройсман А.Д. участвовал в кругосветном переходе ледокола «Анастас Микоян» из Чёрного моря в Бухту Провидения (Анадырский залив, Берингово море).</div><br><div> \n</div><div>\n</div><div>&nbsp; &nbsp;После войны Гройсман А.Д. работал на Николаевском судостроительном заводе, оставив после себя большой трудовой опыт и уважение коллег и учеников.</div><br><div>\n</div><div>Умер Александр Давыдович в 1982 году.\n</div></div>\n            <hr class=\"line\" mbr-style=\"{'width': lineLength + '%'}\">\n        </div>\n        </div>\n</section>",
          "_cid": "rB9zWJ4LXW",
