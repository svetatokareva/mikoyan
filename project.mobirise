              "text-align": "left"
            }
          },
          "_name": "content9",
          "_customHTML": "<section class=\"mbr-section article content9\" group=\"Article\">\n    \n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"0\">\n        <input type=\"range\" inline title=\"Text Width\" name=\"innerWidth\" min=\"50\" max=\"100\" step=\"1\" value=\"100\">\n        <input type=\"range\" inline title=\"Line Width\" name=\"lineLength\" min=\"10\" max=\"100\" step=\"1\" value=\"25\">\n        <input type=\"color\" title=\"Line Color\" name=\"lineColor\" value=\"#149dcc\">\n        <input type=\"color\" title=\"Background Color\" name=\"bgColor\" value=\"#ffffff\">\n    <!-- End block parameters -->\n    </mbr-parameters> \n\n    <div class=\"container\">\n        <div class=\"inner-container\" mbr-style=\"{'width': innerWidth + '%'}\">\n            <hr class=\"line\" mbr-style=\"{'width': lineLength + '%'}\">\n            <div class=\"section-text align-center mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".section-text\" mbr-text><div>&nbsp; &nbsp;Александр Сергеевич Криштопов родился в 1912 году.\n</div><br><div>&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"font-size: 1.2rem;\">У нас есть основания предполагать, что до войны Криштопов А.С. работал на&nbsp;</span><span style=\"font-size: 1.2rem;\">Николаевском судостроительном заводе имени Андре Марти и, может быть,&nbsp;</span><span style=\"font-size: 1.2rem;\">он участвовал в постройке ледокола «Анастас Микоян».&nbsp;</span></div><div><br>&nbsp; &nbsp;&nbsp;<span style=\"font-size: 1.2rem;\">В апреле 1941 Криштопов А.С. был призван в армию Николаевским военкоматом.&nbsp;</span></div><br><div><span style=\"font-size: 1.2rem;\">&nbsp; &nbsp; С июля 1941 года Криштопов А.С. служил трюмным машинистом на&nbsp;</span><span style=\"font-size: 1.2rem;\">вспомогательном крейсере - ледоколе «Анастас Микоян».&nbsp;</span></div><br><div>&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"font-size: 1.2rem;\">В составе экипажа корабля старший краснофлотец Криштопов А.С. участвовал в&nbsp;</span><span style=\"font-size: 1.2rem;\">обороне Одессы и Севастополя. &nbsp;</span></div><br><div>&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"font-size: 1.2rem;\">В 1941 – 1942 годах старший краснофлотец Криштопов А.С. в должности&nbsp;</span><span style=\"font-size: 1.2rem;\">трюмного машиниста участвовал в кругосветном переходе ледокола «Анастас&nbsp;</span><span style=\"font-size: 1.2rem;\">Микоян» из Чёрного моря в Бухту Провидения (Анадырский залив, Берингово&nbsp;</span><span style=\"font-size: 1.2rem;\">море).&nbsp;</span></div><br><div>&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"font-size: 1.2rem;\">После расформирования экипажа Криштопов А.С. продолжил службу на ледоколе&nbsp;</span><span style=\"font-size: 1.2rem;\">«Анастас Микоян». 26 ноября 1942 года при подрыве ледокола на мине в&nbsp;</span><span style=\"font-size: 1.2rem;\">Баренцевом море Александр Сергеевич получил тяжелое ранение, перелом&nbsp;</span></div><div>обеих пяточных костей.\n</div><br><div><span style=\"font-size: 1.2rem;\">&nbsp; &nbsp; После ранения и пребывания в госпитале Александр Сергеевич Криштопов был&nbsp;</span><span style=\"font-size: 1.2rem;\">демобилизован, получил третью группу инвалидности, поскольку очень плохо&nbsp;</span><span style=\"font-size: 1.2rem;\">ходил.&nbsp;</span></div><br><div>&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"font-size: 1.2rem;\">После войны Криштопов А.С. работал заместителем председателя Емецкого&nbsp;</span><span style=\"font-size: 1.2rem;\">Исполкома Райсовета и завотделом гособеспечения (село Емецк Холмогорский&nbsp;</span><span style=\"font-size: 1.2rem;\">район Архангельской области).</span></div></div>\n            <hr class=\"line\" mbr-style=\"{'width': lineLength + '%'}\">\n        </div>\n        </div>\n</section>",
