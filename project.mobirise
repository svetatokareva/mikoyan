              }
            },
            ".section-text DIV": {
              "text-align": "left"
            }
          },
          "_name": "content9",
          "_customHTML": "<section class=\"mbr-section article content9\" group=\"Article\">\n    \n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"0\">\n        <input type=\"range\" inline title=\"Text Width\" name=\"innerWidth\" min=\"50\" max=\"100\" step=\"1\" value=\"100\">\n        <input type=\"range\" inline title=\"Line Width\" name=\"lineLength\" min=\"10\" max=\"100\" step=\"1\" value=\"25\">\n        <input type=\"color\" title=\"Line Color\" name=\"lineColor\" value=\"#149dcc\">\n        <input type=\"color\" title=\"Background Color\" name=\"bgColor\" value=\"#ffffff\">\n    <!-- End block parameters -->\n    </mbr-parameters> \n\n    <div class=\"container\">\n        <div class=\"inner-container\" mbr-style=\"{'width': innerWidth + '%'}\">\n            <hr class=\"line\" mbr-style=\"{'width': lineLength + '%'}\">\n            <div class=\"section-text align-center mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".section-text\" mbr-text><div>&nbsp;&nbsp;&nbsp;&nbsp;Во время Великой Отечественной войны Главный старшина машинной группы&nbsp;<span style=\"font-size: 1.2rem;\">Студенко Г.Ф. служил на вспомогательном крейсере - ледоколе «Анастас&nbsp;</span><span style=\"font-size: 1.2rem;\">Микоян». &nbsp;</span></div><br><div><span style=\"font-size: 1.2rem;\">&nbsp; &nbsp; В 1941 году в составе экипажа корабля Студенко Г.Ф. участвовал в обороне&nbsp;</span><span style=\"font-size: 1.2rem;\">Одессы, Севастополя и Новороссийска. &nbsp;</span></div><br><div><span style=\"font-size: 1.2rem;\">&nbsp; &nbsp; В 1941 – 1942 годах Главстаршина машинной группы Студенко Г.Ф. участвовал&nbsp;</span><span style=\"font-size: 1.2rem;\">в кругосветном переходе&nbsp;ледокола «Анастас Микоян» из Чёрного моря в Бухту&nbsp;</span><span style=\"font-size: 1.2rem;\">Провидения (Анадырский&nbsp;залив, Берингово море). &nbsp;</span></div><br><div>&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"font-size: 1.2rem;\">После войны Георгий Филиппович Студенко жил под Ленинградом в Сестрорецке.&nbsp;</span></div><br><div>&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"font-size: 1.2rem;\">Более 25 лет Студенко Г.Ф. проработал на знаменитом Сестрорецком&nbsp;</span><span style=\"font-size: 1.2rem;\">инструментальном заводе имени С.П. Воскова.&nbsp;</span><span style=\"font-size: 1.2rem;\">За эти годы Студенко Г.Ф. воспитал несколько десятков учеников - токарей,&nbsp;</span><span style=\"font-size: 1.2rem;\">фрезеровщиков.&nbsp;</span></div></div>\n            <hr class=\"line\" mbr-style=\"{'width': lineLength + '%'}\">\n        </div>\n        </div>\n</section>",
