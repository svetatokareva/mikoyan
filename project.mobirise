          "_name": "testimonials2",
          "_customHTML": "<section class=\"testimonials2\" group=\"Testimonials\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n      <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"8\">\n      <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"0\">\n\n      <input type=\"range\" inline title=\"Media Size\" name=\"mediaSize\" min=\"10\" max=\"200\" step=\"5\" value=\"130\">\n\n      <fieldset type=\"background\" name=\"bg\" parallax>\n          <input type=\"image\" title=\"Background Image\" value=\"../_images/background3.jpg\">\n          <input type=\"color\" title=\"Background Color\" value=\"#ffffff\" selected>\n          <input type=\"video\" title=\"Background Video\" value=\"http://www.youtube.com/watch?v=uNCr7NdOJgw\">\n      </fieldset>\n      <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n      <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#232323\" condition=\"overlay && bg.type !== 'color'\">\n      <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n    <!-- End block parameters --> \n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div class=\"container\">\n        <div class=\"media-container-row\">\n            <div class=\"mbr-figure pr-lg-5\" mbr-style=\"{'width':'50%'}\">\n              <img src=\"@PROJECT_PATH@/assets/images/untitled2-3.jpeg\" alt title>\n            </div>\n            <div class=\"media-content px-3 align-self-center mbr-white py-2\">\n                    <p class=\"mbr-text testimonial-text mbr-fonts-style\" mbr-theme-style=\"display-1\" data-app-selector=\".testimonial-text\"><b>РУЗАКОВ</b><br><b>Семен Петрович</b></p>\n                    <p class=\"mbr-author-name pt-4 mb-2 mbr-fonts-style\" mbr-theme-style=\"display-1\" data-app-selector=\".mbr-author-name\"><span style=\"font-weight: normal;font-size: 1.9rem;\">Старший краснофлотец\n<br>Рулевой<br></span><br><span style=\"font-weight: normal;\">1921 - ?</span><br></p>\n                    <p class=\"mbr-author-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-author-desc\"></p>\n            </div>\n        </div>\n    </div>\n</section>",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_cid": "rBDCRLziIA",
          "_anchor": "testimonials2-25",
          "_sourceTheme": "mobirise4",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "background-color": "@bgColor",
            ".line": {
              "background-color": "@lineColor",
              "color": "@lineColor",
              "align": "center",
              "height": "2px",
              "margin": "0 auto"
            },
            ".section-text": {
              "padding": "2rem 0",
              "text-align": "left"
            },
            ".inner-container": {
              "margin": "0 auto"
            },
            "@media (max-width: 768px)": {
              ".inner-container": {
                "width": "100% !important"
              }
            },
            ".section-text DIV": {
              "text-align": "left"
            }
          },
          "_name": "content9",
          "_customHTML": "<section class=\"mbr-section article content9\" group=\"Article\">\n    \n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"0\">\n        <input type=\"range\" inline title=\"Text Width\" name=\"innerWidth\" min=\"50\" max=\"100\" step=\"1\" value=\"100\">\n        <input type=\"range\" inline title=\"Line Width\" name=\"lineLength\" min=\"10\" max=\"100\" step=\"1\" value=\"25\">\n        <input type=\"color\" title=\"Line Color\" name=\"lineColor\" value=\"#149dcc\">\n        <input type=\"color\" title=\"Background Color\" name=\"bgColor\" value=\"#ffffff\">\n    <!-- End block parameters -->\n    </mbr-parameters> \n\n    <div class=\"container\">\n        <div class=\"inner-container\" mbr-style=\"{'width': innerWidth + '%'}\">\n            <hr class=\"line\" mbr-style=\"{'width': lineLength + '%'}\">\n            <div class=\"section-text align-center mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".section-text\" mbr-text>&nbsp; &nbsp; &nbsp;Рузаков Семён Петрович родился в 1921 году. Окончил 6 классов школы, и сразу пошёл работать рабочим.\n<div>\n</div><div>&nbsp; &nbsp;В 1939 году Рузаков С.П был призван на действительную военную службу. Служил в пограничном отряде НКВД в городе Баку. \n</div><br><div><span style=\"font-size: 1.2rem;\">&nbsp; &nbsp;В начале Великой Отечественной войны был командирован на Черноморский флот. &nbsp;</span><br></div><div>27 июля 1941 года старший краснофлотец Рузаков С.П. прибыл на вспомогательный крейсер-ледокол «Анастас Микоян» на штатную должность рулевого.</div><br><div>\n</div><div>\n</div><div>&nbsp; &nbsp;В составе экипажа корабля рулевой Рузаков С.П. участвовал в обороне Одессы и Севастополя. Краснофлотец Рузаков С.П. по каким-то причинам был снят со вспомогательного крейсера ЧФ «А. Микоян» в то время, когда корабль ушёл из Севастополя в Новороссийск и встал на ремонт.</div><br><div>\n</div><div>&nbsp;&nbsp;&nbsp;&nbsp;24 ноября 1941 года, перед самым началом кругосветного похода ледокола «А.  Микоян», накануне выхода корабля из Батуми в Константинополь (Стамбул), Рузаков С.П. вновь прибыл на корабль.\n</div><div><br></div><div> \n</div><div>\n</div><div>&nbsp; &nbsp;Рузаков С.П был снят со вспомогательного крейсера «Анастас Микоян» в то время, когда корабль ушёл из Севастополя в Новороссийск и встал на ремонт.</div><br><div>\n</div><div>\n</div><div>&nbsp; &nbsp;24 ноября 1941 года, перед самым началом кругосветного похода ледокола «Анастас Микоян» и выхода его из Чёрного моря в Константинополь (Стамбул), Рузаков С.П. вновь прибыл на корабль в порт города Батуми.</div><br><div> \n</div><div>\n</div><div>&nbsp; &nbsp;В 1941 – 1942 годах старший краснофлотец рулевой Рузаков С.П. участвовал в кругосветном переходе ледокола «Анастас Микоян» из Чёрного моря в Бухту Провидения (Анадырский залив, Берингово море).</div><br><div> \n</div><div>\n</div><div>&nbsp; &nbsp;При столкновении безоружного экипажа ледокола «А. Микоян» с итало-фашистами в неравном бою у острова Родос (Эгейское – Средиземное море) старший краснофлотец рулевой Семён Рузаков был ранен в ногу осколком, но, несмотря на ранение, остался у руля корабля, выполняя точно все команды командира.</div><br><div>\n</div><div>\n<span style=\"font-size: 1.2rem;\"></span></div><div>&nbsp; &nbsp;После кругосветного похода и расформирования экипажа ледокола «Анастас Микоян», старший краснофлотец рулевой Рузаков С.П. продолжил службу на корабле до 30 августа 1943 года.</div></div>\n            <hr class=\"line\" mbr-style=\"{'width': lineLength + '%'}\">\n        </div>\n        </div>\n</section>",
