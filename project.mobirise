              "color": "#232323"
            }
          },
          "_name": "testimonials2",
          "_customHTML": "<section class=\"testimonials2\" group=\"Testimonials\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n      <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"8\">\n      <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"0\">\n\n      <input type=\"range\" inline title=\"Media Size\" name=\"mediaSize\" min=\"10\" max=\"200\" step=\"5\" value=\"130\">\n\n      <fieldset type=\"background\" name=\"bg\" parallax>\n          <input type=\"image\" title=\"Background Image\" value=\"../_images/background3.jpg\">\n          <input type=\"color\" title=\"Background Color\" value=\"#ffffff\" selected>\n          <input type=\"video\" title=\"Background Video\" value=\"http://www.youtube.com/watch?v=uNCr7NdOJgw\">\n      </fieldset>\n      <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n      <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#232323\" condition=\"overlay && bg.type !== 'color'\">\n      <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n    <!-- End block parameters --> \n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div class=\"container\">\n        <div class=\"media-container-row\">\n            <div class=\"mbr-figure pr-lg-5\" mbr-style=\"{'width':'50%'}\">\n              <img src=\"@PROJECT_PATH@/assets/images/337x4081.jpeg\" alt title>\n            </div>\n            <div class=\"media-content px-3 align-self-center mbr-white py-2\">\n                    <p class=\"mbr-text testimonial-text mbr-fonts-style\" mbr-theme-style=\"display-1\" data-app-selector=\".testimonial-text\"><b>СТЕЦЕНКО</b><br><b>Иван Яковлевич</b></p>\n                    <p class=\"mbr-author-name pt-4 mb-2 mbr-fonts-style\" mbr-theme-style=\"display-1\" data-app-selector=\".mbr-author-name\"><span style=\"font-weight: normal;font-size: 1.9rem;\">Краснофлотец \n<br>Кочегар, котельный мастер<br></span><br><span style=\"font-weight: normal;\">~1885 - 1958&nbsp;</span><br></p>\n                    <p class=\"mbr-author-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-author-desc\"></p>\n            </div>\n        </div>\n    </div>\n</section>",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_cid": "rBDE6AbHNL",
          "_anchor": "testimonials2-2a",
          "_sourceTheme": "mobirise4",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "background-color": "@bgColor",
            ".line": {
              "background-color": "@lineColor",
              "color": "@lineColor",
              "align": "center",
              "height": "2px",
              "margin": "0 auto"
            },
            ".section-text": {
              "padding": "2rem 0",
              "text-align": "left"
            },
            ".inner-container": {
              "margin": "0 auto"
            },
            "@media (max-width: 768px)": {
              ".inner-container": {
                "width": "100% !important"
              }
            },
            ".section-text DIV": {
              "text-align": "left"
            }
          },
          "_name": "content9",
          "_customHTML": "<section class=\"mbr-section article content9\" group=\"Article\">\n    \n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"0\">\n        <input type=\"range\" inline title=\"Text Width\" name=\"innerWidth\" min=\"50\" max=\"100\" step=\"1\" value=\"100\">\n        <input type=\"range\" inline title=\"Line Width\" name=\"lineLength\" min=\"10\" max=\"100\" step=\"1\" value=\"25\">\n        <input type=\"color\" title=\"Line Color\" name=\"lineColor\" value=\"#149dcc\">\n        <input type=\"color\" title=\"Background Color\" name=\"bgColor\" value=\"#ffffff\">\n    <!-- End block parameters -->\n    </mbr-parameters> \n\n    <div class=\"container\">\n        <div class=\"inner-container\" mbr-style=\"{'width': innerWidth + '%'}\">\n            <hr class=\"line\" mbr-style=\"{'width': lineLength + '%'}\">\n            <div class=\"section-text align-center mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".section-text\" mbr-text>&nbsp; &nbsp;Стеценко Иван Яковлевич родился в 1885 году.<br><br>\n<div>\n</div><div>&nbsp; &nbsp;Еще подростком Стеценко И.Я. пришел на Николаевский судостроительный завод \"Наваль\" (в 1924 году переименован в Судостроительный завод им. Андре Марти).&nbsp;\n</div><br><div><span style=\"font-size: 1.2rem;\">&nbsp; &nbsp;Сначала Иван был «мальчиком на побегушках», подручным, потом стал котельщиком. а через какое-то время Стеценко Иван Яковлевич поднялся выше – получил настоящую рабочую специальность – чеканщик – развальцовщик, зачеканивал водогрейные трубки в паровых котлах.&nbsp;</span></div><br><div><span style=\"font-size: 1.2rem;\">&nbsp; &nbsp;В 1941 году, накануне Великой отечественной войны, Стеценко И.Я работал на Николаевском заводе, был первоклассным мастером – чеканщиком, участвовал в строительстве ледокола «Анастас Микоян».</span><br></div><div>\n</div><div><br></div><div>&nbsp; &nbsp;Стеценко И.Я. дружил с Григорием Дьяченко с момента прихода на завод в подростковом возрасте. Они были одногодки, обоим в 1941 году было почти 60 лет. В связи с преклонным возрастом, их не хотели включать в команду корабля, но они настояли и были включены в состав экипажа. Иван Стеценко и Григорий Дьяченко были самыми пожилыми членами команды.&nbsp;</div><br><div>\n</div><div>\n</div><div>&nbsp; &nbsp;В июле 1941 года Стеценко И.Я. стал краснофлотцем.\n</div><div><br></div><div>&nbsp; &nbsp;Вместе с другими «николаевцами – судостроителями» он продолжил службу матросом - кочегаром на вспомогательном крейсере - ледоколе \"Анастас Микоян\", одновременно выполняя и работы котельного мастера.\n</div><br><div><span style=\"font-size: 1.2rem;\">&nbsp; &nbsp;Стеценко Ивана Яковлевича на корабле уважали, за глаза его называли \"Диктатор\" - по прозвищу героя пьесы И.К. Микитенко \"Диктатура\", Дударя, списанного писателем со Стеценко И.Я. в конце 20-ых годов ХХ века.&nbsp;</span><br></div><div>\n</div><div><br></div><div>&nbsp; &nbsp;В составе экипажа корабля краснофлотец Стеценко И.Я. участвовал в обороне Одессы и Севастополя.&nbsp;</div><br><div>\n</div><div>\n</div><div>&nbsp; &nbsp;В 1941 – 1942 годах матрос – кочегар, котельный мастер Стеценко И.Я. участвовал в кругосветном переходе ледокола «Анастас Микоян» из Чёрного моря в Бухту Провидения (Анадырский залив, Берингово море).&nbsp;</div><br><div>\n</div><div>\n</div><div>&nbsp; &nbsp;После войны Стеценко Иван Яковлевич вернулся в город Николаев на родной судостроительный завод и проработал на заводе почти до самой смерти.</div><br><div>\n</div><div>\n</div><div>&nbsp; &nbsp;Стеценко И.Я был награжден двумя орденами Ленина и орденом Знак почета. Умер Стеценко в 1958 году, ему было 73 года.\n</div><div><br><div>&nbsp; &nbsp;Фотографии на страницу добавлены по описанию из книги. Возможно, авторы сайта неверно узнали Стеценко на фотографиях.</div></div></div>\n            <hr class=\"line\" mbr-style=\"{'width': lineLength + '%'}\">\n        </div>\n        </div>\n</section>",
          "_cid": "rBDE6AZvsL",
          "_anchor": "content9-2b",
          "_sourceTheme": "mobirise4",
          "_protectedParams": [],
