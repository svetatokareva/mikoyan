              "color": "#232323"
            }
          },
          "_name": "testimonials2",
          "_customHTML": "<section class=\"testimonials2\" group=\"Testimonials\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n      <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"8\">\n      <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"0\">\n\n      <input type=\"range\" inline title=\"Media Size\" name=\"mediaSize\" min=\"10\" max=\"200\" step=\"5\" value=\"130\">\n\n      <fieldset type=\"background\" name=\"bg\" parallax>\n          <input type=\"image\" title=\"Background Image\" value=\"../_images/background3.jpg\">\n          <input type=\"color\" title=\"Background Color\" value=\"#ffffff\" selected>\n          <input type=\"video\" title=\"Background Video\" value=\"http://www.youtube.com/watch?v=uNCr7NdOJgw\">\n      </fieldset>\n      <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n      <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#232323\" condition=\"overlay && bg.type !== 'color'\">\n      <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n    <!-- End block parameters --> \n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div class=\"container\">\n        <div class=\"media-container-row\">\n            <div class=\"mbr-figure pr-lg-5\" mbr-style=\"{'width':'50%'}\">\n              <img src=\"@PROJECT_PATH@/assets/images/2-3-510x644.jpeg\" alt title>\n            </div>\n            <div class=\"media-content px-3 align-self-center mbr-white py-2\">\n                    <p class=\"mbr-text testimonial-text mbr-fonts-style\" mbr-theme-style=\"display-1\" data-app-selector=\".testimonial-text\"><b>ГОЛОВАНЬ</b><br><b>Дмитрий Павлович</b></p>\n                    <p class=\"mbr-author-name pt-4 mb-2 mbr-fonts-style\" mbr-theme-style=\"display-1\" data-app-selector=\".mbr-author-name\"><span style=\"font-weight: normal;font-size: 1.9rem;\">Старшина 2-й статьи</span><br><span style=\"font-weight: normal;font-size: 1.9rem;\">Машинист<br></span><br><span style=\"font-weight: normal;\">1918 - 2002</span><br></p>\n                    <p class=\"mbr-author-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-author-desc\"></p>\n            </div>\n        </div>\n    </div>\n</section>",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_cid": "rXdOs9Ttdi",
          "_anchor": "testimonials2-1o9",
          "_sourceTheme": "mobirise4",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "background-color": "@bgColor",
            ".line": {
              "background-color": "@lineColor",
              "color": "@lineColor",
              "align": "center",
              "height": "2px",
              "margin": "0 auto"
            },
            ".section-text": {
              "padding": "2rem 0",
              "text-align": "left"
            },
            ".inner-container": {
              "margin": "0 auto"
            },
            "@media (max-width: 768px)": {
              ".inner-container": {
                "width": "100% !important"
              }
            },
            ".section-text DIV": {
              "text-align": "left"
            }
          },
          "_name": "content9",
          "_customHTML": "<section class=\"mbr-section article content9\" group=\"Article\">\n    \n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"0\">\n        <input type=\"range\" inline title=\"Text Width\" name=\"innerWidth\" min=\"50\" max=\"100\" step=\"1\" value=\"100\">\n        <input type=\"range\" inline title=\"Line Width\" name=\"lineLength\" min=\"10\" max=\"100\" step=\"1\" value=\"25\">\n        <input type=\"color\" title=\"Line Color\" name=\"lineColor\" value=\"#149dcc\">\n        <input type=\"color\" title=\"Background Color\" name=\"bgColor\" value=\"#ffffff\">\n    <!-- End block parameters -->\n    </mbr-parameters> \n\n    <div class=\"container\">\n        <div class=\"inner-container\" mbr-style=\"{'width': innerWidth + '%'}\">\n            <hr class=\"line\" mbr-style=\"{'width': lineLength + '%'}\">\n            <div class=\"section-text align-center mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".section-text\" mbr-text><div>&nbsp; &nbsp; Дмитрий Павлович Головань родился в 1918 году на хуторе Плужники Полтавской губернии Яготинского района.</div><br><div>\n</div><div>&nbsp; &nbsp; В 1933 году Головань Д.П. уехал в Славянск Донецкой области и поступил в ФЗУ учиться на машиниста паровоза. В 1936 году окончил училище и работал помощником машиниста 2 года.</div><br><div> \n</div><div>&nbsp; &nbsp; В 1938 году Головань Д.П. был призван на Черноморский флот (ему было 20 лет). Служил на различных кораблях ЧФ.\n</div><div>В июле 1941 года Головань Д.П. был направлен на службу в команду ледокола - вспомогательного крейсера ЧФ \"Анастас Микоян». Дмитрий Павлович был уже готовый машинист паровых котлов с опытом работы.</div><br><div>\n</div><div>&nbsp; &nbsp; На ледоколе «А. Микоян старшина 2 статьи Головань Д.П. служил в машинном отделении, машинистом.</div><br><div>\n</div><div>&nbsp; &nbsp; В составе экипажа ледокола - вспомогательного крейсера ЧФ «А. Микоян» старшина 2 статьи Головань Д.П. участвовал в обороне Одессы, Севастополя и Новороссийска.</div><br><div> \n</div><div>&nbsp; &nbsp; В 1941 – 1942 годах Головань Д.П. участвовал в кругосветном переходе ледокола «А. Микоян» из Чёрного моря в Бухту Провидения (Анадырский залив, Берингово море).</div><br><div> \n</div><div>&nbsp; &nbsp; После кругосветного перехода Головань Д.П. продолжил службу на ледоколе «А. Микоян», и до конца войны, до 1956 года, когда ледокол был снят с вооружения Советской армии, Головань Д.П. продолжал служить на ледоколе.</div><br><div>\n</div><div>&nbsp; &nbsp; Головань Д.П. вышел в отставку в 1956 году в звании капитана 3 ранга.</div><br><div>\n</div><div>&nbsp; &nbsp; После войны Головань Д.П. сначала жил в городе Славянск, а затем в Краматорске.</div><br><div> \n</div><div>&nbsp; &nbsp; В Краматорске его сразу взяли на работу в Исполком, заместителем начальника народного контроля и сразу выдали квартиру. К тому времени Дмитрий Павлович был женат и имел сына Сергея (1951 года рождения) и дочь, Елену (1959 года рождения).</div><br><div>\n</div><div>&nbsp; &nbsp; В 60 – 70–ые годы Головань Д.П. работал директором посудо-эмалированного завода, потом директором службы быта города, а затем начальником цеха Крематорского цементно - шиферного завода. Дмитрий Павлович был уже пред пенсионного возраста, когда ему предложили быть директором пионерского лагеря «Космическая чайка» на станции Брусин, Красно Лиманского района. Там же они с женой купили домик в посёлке Брусин, где семья и жила до 2022 года.</div><br><div>\n</div><div>&nbsp; &nbsp; Головань Дмитрий Павлович, умер 8 февраля 2002, похоронен в Краматорске вместе с женой, Лидией Ивановной (умерла в 1997 году).</div><div>\n</div><div>\n</div><div>\n</div><div>\n</div><div>\n</div></div>\n            <hr class=\"line\" mbr-style=\"{'width': lineLength + '%'}\">\n        </div>\n        </div>\n</section>",
          "_cid": "rXdOsauh3m",
          "_anchor": "content9-1oa",
          "_sourceTheme": "mobirise4",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
