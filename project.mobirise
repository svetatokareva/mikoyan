              "color": "#232323"
            }
          },
          "_name": "testimonials2",
          "_customHTML": "<section class=\"testimonials2\" group=\"Testimonials\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n      <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"8\">\n      <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"0\">\n\n      <input type=\"range\" inline title=\"Media Size\" name=\"mediaSize\" min=\"10\" max=\"200\" step=\"5\" value=\"130\">\n\n      <fieldset type=\"background\" name=\"bg\" parallax>\n          <input type=\"image\" title=\"Background Image\" value=\"../_images/background3.jpg\">\n          <input type=\"color\" title=\"Background Color\" value=\"#ffffff\" selected>\n          <input type=\"video\" title=\"Background Video\" value=\"http://www.youtube.com/watch?v=uNCr7NdOJgw\">\n      </fieldset>\n      <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n      <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#232323\" condition=\"overlay && bg.type !== 'color'\">\n      <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n    <!-- End block parameters --> \n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div class=\"container\">\n        <div class=\"media-container-row\">\n            <div class=\"mbr-figure pr-lg-5\" mbr-style=\"{'width':'50%'}\">\n              <img src=\"@PROJECT_PATH@/assets/images/1943-img805-restored-660x1038.jpg\" alt title>\n            </div>\n            <div class=\"media-content px-3 align-self-center mbr-white py-2\">\n                    <p class=\"mbr-text testimonial-text mbr-fonts-style\" mbr-theme-style=\"display-1\" data-app-selector=\".testimonial-text\"><b>СЕРГЕЕВ <br>Сергей Михайлович</b>\n<br></p>\n                    <p class=\"mbr-author-name pt-4 mb-2 mbr-fonts-style\" mbr-theme-style=\"display-1\" data-app-selector=\".mbr-author-name\"><span style=\"font-weight: normal;font-size: 1.9rem;\">Капитан 2 ранга </span><br><span style=\"font-weight: normal;font-size: 1.9rem;\">Командир корабля</span><br><span style=\"font-weight: normal;\">&nbsp;</span><br><span style=\"font-weight: normal;\">1901 (1897) - 1979</span></p>\n                    <p class=\"mbr-author-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-author-desc\"></p>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "rB4fUEnoqV",
          "_anchor": "testimonials2-x",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_sourceTheme": "mobirise4",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "background-color": "@bgColor",
            ".line": {
              "background-color": "@lineColor",
              "color": "@lineColor",
              "align": "center",
              "height": "2px",
              "margin": "0 auto"
            },
            ".section-text": {
              "padding": "2rem 0",
              "text-align": "left"
            },
            ".inner-container": {
              "margin": "0 auto"
            },
            "@media (max-width: 768px)": {
              ".inner-container": {
                "width": "100% !important"
              }
            },
            ".section-text DIV": {
              "text-align": "left"
            }
          },
          "_name": "content9",
          "_customHTML": "<section class=\"mbr-section article content9\" group=\"Article\">\n    \n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"0\">\n        <input type=\"range\" inline title=\"Text Width\" name=\"innerWidth\" min=\"50\" max=\"100\" step=\"1\" value=\"100\">\n        <input type=\"range\" inline title=\"Line Width\" name=\"lineLength\" min=\"10\" max=\"100\" step=\"1\" value=\"25\">\n        <input type=\"color\" title=\"Line Color\" name=\"lineColor\" value=\"#149dcc\">\n        <input type=\"color\" title=\"Background Color\" name=\"bgColor\" value=\"#ffffff\">\n    <!-- End block parameters -->\n    </mbr-parameters> \n\n    <div class=\"container\">\n        <div class=\"inner-container\" mbr-style=\"{'width': innerWidth + '%'}\">\n            <hr class=\"line\" mbr-style=\"{'width': lineLength + '%'}\">\n            <div class=\"section-text align-center mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".section-text\" mbr-text>&nbsp; &nbsp;Сергей Михайлович Сергеев (Ростовцев) происходил из семьи потомственных военных: и его отец, и его дед, и прадед -  служили России.<br><br> \n<div>&nbsp; &nbsp;Отец, Ростовцев Михаил (1866 – 1943), кадровый офицер, полковник, артиллерист, закончил Академию Генерального штаба. Как боевой офицер прошёл три войны: Балканскую, Японскую и Империалистическую (Германскую), - имел Георгиевское оружие, кресты, ордена.</div><br><div> \n</div><div>&nbsp; &nbsp;Маленький Серёжа с детства бредил морем, мечтал стать моряком. Он рассказывал, что, когда мальчишкой держал игрушечный кораблик, руки его дрожали и сердце билось от восторга.</div><br><div> \n</div><div>&nbsp; &nbsp;С. М. Сергеев родился в Петербурге в 1901 году (угол Невского и Большой Морской улицы) – по официальной версии и изменённым документам -  в 1897 году.</div><br><div>\n</div><div>&nbsp; &nbsp;В 1913 году успешно сдал экзамены по программе реального училища (4 класса) и поступил в Мореходное училище Дальнего плавания (Санкт-Петербург), успел до революции окончить 3 курса кадетских младших классов.</div><br><div>\n</div><div>&nbsp; &nbsp;Для поступления в морское училище Дальнего плавания требовался морской стаж, и в 1912 году Серёжа, ему было 11 лет,  (Сергеев С.М.) плавал юнгой на судне «Тула» Доброфлота («Добровольческий флот»), выполняя обязанности матроса 2 класса. Корабль вышел «из Петербурга в Ревель и проследовал во Владивосток с заходом в Европейские, Африканские, Индийские, Китайские и Японские порты с возвращением в Чёрное море» (Сведения из Автобиографии Сергеева С.М.). Это было его первое «кругосветное» плавание.</div><br><div> \n</div><div>&nbsp; &nbsp;В дальнейшем каждое лето до 1916 года Сергеев С.М. проходил практику на кораблях Балтийского флота с заходом в разные зарубежные порты (Швеция, Норвегия, Германия).</div><br><div>\n</div><div>&nbsp; &nbsp;В 1916 году плавал на корабле Балтийского флота «Елизавета» рулевым, а после призыва в действующую армию служил на крейсере «Россия».</div><br><div>\n</div><div>&nbsp; &nbsp;1918-1922 год – участник Гражданской войны. После гражданской войны он оставил <a href=\"assets/files/%D0%94%D0%BE%D0%BA%D1%83%D0%BC%D0%B5%D0%BD%D1%82%D0%B0%D0%BB%D1%8C%D0%BD%D1%8B%D0%B5%20%D1%80%D0%B0%D1%81%D1%81%D0%BA%D0%B0%D0%B7%D1%8B-%D0%B2%D0%BE%D1%81%D0%BF%D0%BE%D0%BC%D0%B8%D0%BD%D0%B0%D0%BD%D0%B8%D1%8F%20%D0%BE%20%D0%93%D1%80%D0%B0%D0%B6%D0%B4%D0%B0%D0%BD%D1%81%D0%BA%D0%BE%D0%B9%20%D0%B2%D0%BE%D0%B9%D0%BD%D0%B5%20%D0%BA%D0%B0%D0%BF%D0%B8%D1%82%D0%B0%D0%BD%D0%B0%201%20%D1%80%D0%B0%D0%BD%D0%B3%D0%B0%20%D0%A1%D0%B5%D1%80%D0%B3%D0%B5%D0%B5%D0%B2%D0%B0%20%D0%A1.%D0%9C.pdf\" target=\"_blank\">воспоминания</a>.</div><br><div>\n</div><div>&nbsp; &nbsp;В 1924 году окончил Академию Фрунзе.</div><br><div>\n</div><div>&nbsp; &nbsp;В 1929 году, в качестве командира минного заградителя «Сильный» участвовал в высадке десанта во время конфликта на КВЖД.</div><br><div>\n</div><div>&nbsp; &nbsp;Сергеев С.М. был награжден Василием Блюхером почетным революционным оружием – «наган»</div><br><div>\n</div><div>&nbsp; &nbsp;Во время Гражданской войны в Испании 1937-1939 годы Дон Корнели Гуардия Лопес, он же военный моряк — доброволец Сергеев Сергей Михайлович – выполнял свой интернациональный долг в качестве начальника штаба дивизиона миноносцев Испанской республики, командовал флотилией эскадренных миноносцев, сражался с фашистами. Двумя боевыми орденами и медалью отметила Родина его заслуги в сражениях за далекую Испанию. Был у него и орден – памятный знак Испанской Республики.</div><br><div>&nbsp; &nbsp;&nbsp;<span style=\"font-size: 1.2rem;\">С марта 1939 года до 1 июля 1941 года командовал эскадренным миноносцем «Быстрый» в Севастополе.</span></div><div>\n</div><div>С июля 1941 года командовал только что рожденным на стапелях Николаева новым мощным ледоколом «А. Микоян».</div><br><div> \n</div><div>&nbsp; &nbsp;Капитан второго ранга Сергеев С.М. превратил его в крейсер, вооружил, скомплектовал команду и сражался под Одессой и Севастополем, а затем получил важное правительственное задание вновь превратить крейсер в мирный ледокол, разоружить его и привести его из Чёрного моря в Бухту Провидения (Анадырский пролив Берингово море).</div><br><div> \n</div><div>&nbsp;У командира Сергеева С.М имелся приказ – взорвать и затопить судно в случае безвыходной ситуации. И об этом приказе знал весь экипаж. Это был потенциальный «Варяг».</div><br><div>\n</div><div>&nbsp; &nbsp;Начинается беспримерная история кругосветного плавания крейсера-ледокола «А. Микоян» …</div><br><div>\n</div><div>&nbsp; &nbsp;В советском Военно-Морском флоте это было единственное кругосветное плавание (кроме атомных подводных лодок), и было оно совершенно во время войны в 1941-1942 гг. линейным ледоколом «Микоян». С.М. Сергеев вел <a href=\"assets/files/Дневник С.М. Сергеева с комментариями.pdf\" target=\"_blank\">дневик </a>с начала войны и до конца кругосветки.</div><br><div>&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"font-size: 1.2rem;\">9 августа 1942 года ледокол «Микоян» целым и невредимым, не потеряв никого из экипажа (165 человек) пришёл в Бухту Проведения. Правительственное задание было выполнено. До 1958 года этот поход имел гриф «секретно».&nbsp;</span><br></div><br><div> \n</div><div>\n</div><div>&nbsp; &nbsp;14 августа 1942 года   С. М. Сергеев был отозван с ледокола и отбыл сначала в Москву, а затем был вновь отправлен на Тихоокеанский флот, где принял боевой корабль.&nbsp;</div><br><div> \n</div><div>С сентября 1942 года работал Старшим Уполномоченным Постоянной приемной Комиссии ВМФ по приёмке новых военных кораблей, затем служил в составе Амурской военной флотилии, был начальником инспекции 3-го отдела Управления боевой подготовки Главного морского штаба. Участвовал в советско-японской войне с августа по сентябрь 1945 года.</div><br><div>\n</div><div>&nbsp; &nbsp;Сергеев Сергей Михайлович получил звание капитана 1 ранга, орден «Красное Знамя» и «Орден Ленина».</div><br><div>\n</div><div>\n</div><div>После войны служил на Северном флоте командиром - капитаном по приёмке военных кораблей. \n</div><div>Вышел в отставку в 1957 году в звании капитана 1-го ранга и капитана Дальнего Плавания, «с правом ношения военной формы одежды».</div><br><div>\n</div><div>&nbsp; &nbsp;Ушёл из жизни 1 мая 1979 года.</div></div>\n            <hr class=\"line\" mbr-style=\"{'width': lineLength + '%'}\">\n        </div>\n        </div>\n</section>",
          "_cid": "rB4kOiHkei",
          "_anchor": "content9-11",
          "_sourceTheme": "mobirise4",
