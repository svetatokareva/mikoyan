            }
          },
          "_name": "testimonials2",
          "_customHTML": "<section class=\"testimonials2\" group=\"Testimonials\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n      <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"8\">\n      <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"0\">\n\n      <input type=\"range\" inline title=\"Media Size\" name=\"mediaSize\" min=\"10\" max=\"200\" step=\"5\" value=\"130\">\n\n      <fieldset type=\"background\" name=\"bg\" parallax>\n          <input type=\"image\" title=\"Background Image\" value=\"../_images/background3.jpg\">\n          <input type=\"color\" title=\"Background Color\" value=\"#ffffff\" selected>\n          <input type=\"video\" title=\"Background Video\" value=\"http://www.youtube.com/watch?v=uNCr7NdOJgw\">\n      </fieldset>\n      <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n      <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#232323\" condition=\"overlay && bg.type !== 'color'\">\n      <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n    <!-- End block parameters --> \n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div class=\"container\">\n        <div class=\"media-container-row\">\n            <div class=\"mbr-figure pr-lg-5\" mbr-style=\"{'width':'50%'}\">\n              <img src=\"@PROJECT_PATH@/assets/images/untitled2-3.jpeg\" alt title>\n            </div>\n            <div class=\"media-content px-3 align-self-center mbr-white py-2\">\n                    <p class=\"mbr-text testimonial-text mbr-fonts-style\" mbr-theme-style=\"display-1\" data-app-selector=\".testimonial-text\"><b>ОВОДКОВ</b><br><b>Максим Михайлович&nbsp;</b><br></p>\n                    <p class=\"mbr-author-name pt-4 mb-2 mbr-fonts-style\" mbr-theme-style=\"display-1\" data-app-selector=\".mbr-author-name\"><span style=\"font-weight: normal;font-size: 1.9rem;\">Старший краснофлотец</span><br><span style=\"font-weight: normal;font-size: 1.9rem;\">Электрик<br></span><br><span style=\"font-weight: normal;\">1918 - ?</span><br></p>\n                    <p class=\"mbr-author-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-author-desc\"></p>\n            </div>\n        </div>\n    </div>\n</section>",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_cid": "rXeV7nNbah",
          "_anchor": "testimonials2-1pj",
          "_sourceTheme": "mobirise4",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "background-color": "@bgColor",
            ".line": {
              "background-color": "@lineColor",
              "color": "@lineColor",
              "align": "center",
              "height": "2px",
              "margin": "0 auto"
            },
            ".section-text": {
              "padding": "2rem 0",
              "text-align": "left"
            },
            ".inner-container": {
              "margin": "0 auto"
            },
            "@media (max-width: 768px)": {
              ".inner-container": {
                "width": "100% !important"
              }
            },
            ".section-text DIV": {
              "text-align": "left"
            }
          },
          "_name": "content9",
          "_customHTML": "<section class=\"mbr-section article content9\" group=\"Article\">\n    \n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"0\">\n        <input type=\"range\" inline title=\"Text Width\" name=\"innerWidth\" min=\"50\" max=\"100\" step=\"1\" value=\"100\">\n        <input type=\"range\" inline title=\"Line Width\" name=\"lineLength\" min=\"10\" max=\"100\" step=\"1\" value=\"25\">\n        <input type=\"color\" title=\"Line Color\" name=\"lineColor\" value=\"#149dcc\">\n        <input type=\"color\" title=\"Background Color\" name=\"bgColor\" value=\"#ffffff\">\n    <!-- End block parameters -->\n    </mbr-parameters> \n\n    <div class=\"container\">\n        <div class=\"inner-container\" mbr-style=\"{'width': innerWidth + '%'}\">\n            <hr class=\"line\" mbr-style=\"{'width': lineLength + '%'}\">\n            <div class=\"section-text align-center mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".section-text\" mbr-text><p>&nbsp;&nbsp;&nbsp;&nbsp;Оводков Максим Михайлович родился в 1918 году. По одним документам местом его рождения является село Малые Алабухи Первые под Воронежем,&nbsp; по другим - деревня Липиловка под Тулой.</p><br><p><span style=\"font-size: 1.2rem;\">&nbsp; &nbsp;&nbsp;</span><span style=\"font-size: 1.2rem;\">В 1939 году Оводков М.М. был призван во флот городским Мытищинским\n&nbsp;</span><span style=\"font-size: 1.2rem;\">военкоматом.&nbsp;</span><br></p><p></p><br><p></p><div><span style=\"font-size: 1.2rem;\">&nbsp; &nbsp; В 1941 году старший краснофлотец Оводков М.М. был направлен электриком&nbsp;</span><span style=\"font-size: 1.2rem;\">на вспомогательный крейсер «А. Микоян» для прохождения дальнейшей службы.&nbsp;</span></div><p></p><br><p></p><div><span style=\"font-size: 1.2rem;\">&nbsp; &nbsp; В составе экипажа вспомогательного крейсера «А. Микоян» Оводков М.М.&nbsp;</span><span style=\"font-size: 1.2rem;\">участвовал в обороне Одессы, Севастополя и Новороссийска. &nbsp; &nbsp;</span></div><p></p><br><p></p><div><span style=\"font-size: 1.2rem;\">&nbsp; &nbsp; В 1941 – 1942 годах старший краснофлотец электрик Оводков М.М. участвовал&nbsp;</span><span style=\"font-size: 1.2rem;\">в кругосветном переходе ледокола «Анастас Микоян» из Чёрного моря в Бухту&nbsp;</span><span style=\"font-size: 1.2rem;\">Провидения (Анадырский залив, Берингово море).&nbsp;</span></div><p></p><br><p></p><div><span style=\"font-size: 1.2rem;\">&nbsp; &nbsp; После расформирования экипажа &nbsp;ледокола «Анастас Микоян» Оводков М.М.&nbsp;</span><span style=\"font-size: 1.2rem;\">продолжил службу на эсминце «Карл Либкнехт».&nbsp;</span></div><p></p><br><p></p><div><span style=\"font-size: 1.2rem;\">&nbsp; &nbsp; Максим Михайлович Оводков уволился в запас в июле 1946 года.&nbsp;</span></div><p></p><br><p></p><div><span style=\"font-size: 1.2rem;\">&nbsp; &nbsp; Дальнейшая судьба моряка неизвестна.</span><br></div><p></p></div>\n            <hr class=\"line\" mbr-style=\"{'width': lineLength + '%'}\">\n        </div>\n        </div>\n</section>",
          "_cid": "rXeV7ooxjm",
