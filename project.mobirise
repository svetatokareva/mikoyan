              }
            },
            ".mbr-author-desc": {
              "color": "#232323"
            }
          },
          "_name": "testimonials2",
          "_customHTML": "<section class=\"testimonials2\" group=\"Testimonials\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n      <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"8\">\n      <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"0\">\n\n      <input type=\"range\" inline title=\"Media Size\" name=\"mediaSize\" min=\"10\" max=\"200\" step=\"5\" value=\"130\">\n\n      <fieldset type=\"background\" name=\"bg\" parallax>\n          <input type=\"image\" title=\"Background Image\" value=\"../_images/background3.jpg\">\n          <input type=\"color\" title=\"Background Color\" value=\"#ffffff\" selected>\n          <input type=\"video\" title=\"Background Video\" value=\"http://www.youtube.com/watch?v=uNCr7NdOJgw\">\n      </fieldset>\n      <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n      <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#232323\" condition=\"overlay && bg.type !== 'color'\">\n      <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n    <!-- End block parameters --> \n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div class=\"container\">\n        <div class=\"media-container-row\">\n            <div class=\"mbr-figure pr-lg-5\" mbr-style=\"{'width':'50%'}\">\n              <img src=\"@PROJECT_PATH@/assets/images/1960-660x746.jpeg\" alt title>\n            </div>\n            <div class=\"media-content px-3 align-self-center mbr-white py-2\">\n                    <p class=\"mbr-text testimonial-text mbr-fonts-style\" mbr-theme-style=\"display-1\" data-app-selector=\".testimonial-text\"><b>ПОЛИЩУК <br>Емельян Гаврилович\n</b><br></p>\n                    <p class=\"mbr-author-name pt-4 mb-2 mbr-fonts-style\" mbr-theme-style=\"display-1\" data-app-selector=\".mbr-author-name\"><span style=\"font-weight: normal;font-size: 1.9rem;\">Старшина 2-й статьи\n<br>Командир отделения сигнальщиков<br></span><br><span style=\"font-weight: normal;\">1915 - между 1970 и 1975</span><br></p>\n                    <p class=\"mbr-author-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-author-desc\"></p>\n            </div>\n        </div>\n    </div>\n</section>",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_cid": "rBa0LaEHLX",
          "_anchor": "testimonials2-10",
          "_sourceTheme": "mobirise4",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "background-color": "@bgColor",
            ".line": {
              "background-color": "@lineColor",
              "color": "@lineColor",
              "align": "center",
              "height": "2px",
              "margin": "0 auto"
            },
            ".section-text": {
              "padding": "2rem 0",
              "text-align": "left"
            },
            ".inner-container": {
              "margin": "0 auto"
            },
            "@media (max-width: 768px)": {
              ".inner-container": {
                "width": "100% !important"
              }
            },
            ".section-text DIV": {
              "text-align": "left"
            }
          },
          "_name": "content9",
          "_customHTML": "<section class=\"mbr-section article content9\" group=\"Article\">\n    \n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"0\">\n        <input type=\"range\" inline title=\"Text Width\" name=\"innerWidth\" min=\"50\" max=\"100\" step=\"1\" value=\"100\">\n        <input type=\"range\" inline title=\"Line Width\" name=\"lineLength\" min=\"10\" max=\"100\" step=\"1\" value=\"25\">\n        <input type=\"color\" title=\"Line Color\" name=\"lineColor\" value=\"#149dcc\">\n        <input type=\"color\" title=\"Background Color\" name=\"bgColor\" value=\"#ffffff\">\n    <!-- End block parameters -->\n    </mbr-parameters> \n\n    <div class=\"container\">\n        <div class=\"inner-container\" mbr-style=\"{'width': innerWidth + '%'}\">\n            <hr class=\"line\" mbr-style=\"{'width': lineLength + '%'}\">\n            <div class=\"section-text align-center mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".section-text\" mbr-text><div>&nbsp; &nbsp;Полищук Емельян Гаврилович родился в 24 июля 1915 года в селе Александровка под Винницей. До революции его родители крестьянствовали, после революции вступили в колхоз.&nbsp;</div><br><div>&nbsp; &nbsp; В 1929 году Полищук Е. Г. окончил 6 классов неполной средней школы села Ободное под Винницей.&nbsp;</div><br><div>&nbsp; &nbsp; С 1930 по 1933 год Полищук Е. Г. работал учетчиком в колхозе имени Кирова.&nbsp;<br></div><br><div>&nbsp; &nbsp; С 1933 по 1934 год Емельян Гаврирович обучался в восьмимесячной школе садоводов при Агротехникуме села Гуменное Винницкой области, после чего вернулся в колхоз и до 1936 года работал заместителем председателя колхоза по массовой работе.&nbsp;<br></div><div><br></div><div>&nbsp; &nbsp;В июле 1936 году Полищук Е. Г. был призван во флот и служил учеником сигнальщика, а затем сигнальщиком на эсминцах Черноморского Флота. Кроме того, он стал секретарем бюро ВЛКСМ на эсминце \"Быстрый\" в 1938 году.</div><div>&nbsp;</div><div>\n</div><div>&nbsp; &nbsp;В июне 1941 года старшина 2-ой статьи Полищук Е. Г. служил на эсминце \"Быстрый\". Командиром корабля был временно назначен капитан Сергеев С. М. \n<span style=\"font-size: 1.2rem;\">26 июня 1941 года был получен приказ перегнать эсминец в Николаев на ремонт.&nbsp;</span></div><div>Выходя из Южной бухты Севастополя, при проходе первой линии бонов (глубина 14-16 метров),  эсминец подорвался на донной мине, сброшенной немецким самолётом. В результате взрыва 24 человека погибли на месте, а 81 человек получили ранения и контузии (в том числе был ранен Полищук Е. Г., а капитан  Сергеев С. М. «получил сильную общую контузию»). &nbsp;\n</div><div>&nbsp;</div><div>\n</div><div>&nbsp; &nbsp;После излечения Полищук Е. Г.  был направлен на службу в команду ледокола - вспомогательного крейсера \"Анастас Микоян\", которым уже командовал капитан Сергеев С. М. \n<span style=\"font-size: 1.2rem;\">Полищук Е. Г. исполнял на ледоколе «Анастас Микоян»  должность командира отделения сигнальщиков.&nbsp;</span><span style=\"font-size: 1.2rem;\">В неравном бою с итальянскими фашистами в Эгейском море Полищук Е. Г. был еще раз ранен. </span><span style=\"font-size: 1.2rem;\">Старшина 2-ой статьи Полищук Е. Г, прошёл на ледоколе «Анастас Микоян» 4 океана и 17 морей и благополучно прибыл вместе с кораблём в Бухту Провидения (Анадырский залив, Берингово море). &nbsp; &nbsp;</span></div><div><span style=\"font-size: 1.2rem;\"><br></span></div><div>&nbsp; &nbsp;После расформирования экипажа в Бухте Провидения, продолжил службу в военной команде ледокола «Анастас Микоян». Из наградного листа: «Арктическим путём прибыли в Беломорскую военную флотилию, где занимались проводкой караванов в Белом море, идущих из США».</div><br><div>\n</div><div>&nbsp;&nbsp;&nbsp;&nbsp;Емельян Гаврилович был демобилизован в феврале 1946 года в звании Старшины I статьи.</div><br><div>&nbsp; &nbsp; Умер Емельян Гаврилович Полищук между 1970 и 1975 годами.</div><div><br></div></div>\n            <hr class=\"line\" mbr-style=\"{'width': lineLength + '%'}\">\n        </div>\n        </div>\n</section>",
          "_cid": "rBa0LbkdWM",
          "_anchor": "content9-11",
          "_sourceTheme": "mobirise4",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
