              "padding": "2rem 0",
              "text-align": "left"
            },
            ".inner-container": {
              "margin": "0 auto"
            },
            "@media (max-width: 768px)": {
              ".inner-container": {
                "width": "100% !important"
              }
            },
            ".section-text DIV": {
              "text-align": "left"
            }
          },
          "_name": "content9",
          "_customHTML": "<section class=\"mbr-section article content9\" group=\"Article\">\n    \n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"0\">\n        <input type=\"range\" inline title=\"Text Width\" name=\"innerWidth\" min=\"50\" max=\"100\" step=\"1\" value=\"100\">\n        <input type=\"range\" inline title=\"Line Width\" name=\"lineLength\" min=\"10\" max=\"100\" step=\"1\" value=\"25\">\n        <input type=\"color\" title=\"Line Color\" name=\"lineColor\" value=\"#149dcc\">\n        <input type=\"color\" title=\"Background Color\" name=\"bgColor\" value=\"#ffffff\">\n    <!-- End block parameters -->\n    </mbr-parameters> \n\n    <div class=\"container\">\n        <div class=\"inner-container\" mbr-style=\"{'width': innerWidth + '%'}\">\n            <hr class=\"line\" mbr-style=\"{'width': lineLength + '%'}\">\n            <div class=\"section-text align-center mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".section-text\" mbr-text><div>&nbsp;&nbsp;&nbsp;&nbsp;Тетерман Михаил Евгеньевич родился в 1910 году и до Великой Отечественной войны жил в городе Николаеве.\n</div><br><div>&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"font-size: 1.2rem;\">Вероятно, работал на Николаевском судостроительном заводе имени Андре&nbsp;</span><span style=\"font-size: 1.2rem;\">Марти, возможно, участвовал в постройке ледокола «Анастас Микоян».&nbsp;</span></div><br><div>&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"font-size: 1.2rem;\">В 1941 году Тетерман М.Е. был мобилизован, стал краснофлотцем и вместе с&nbsp;</span><span style=\"font-size: 1.2rem;\">другими «николаевцами – судостроителями» продолжил службу на&nbsp;</span><span style=\"font-size: 1.2rem;\">вспомогательном крейсере – ледоколе «Анастас Микоян».&nbsp;</span></div><br><div>&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"font-size: 1.2rem;\">В составе экипажа вспомогательного крейсера старший матрос Тетерман М. Е.&nbsp;</span><span style=\"font-size: 1.2rem;\">участвовал в обороне Одессы и Севастополя.&nbsp;</span></div><br><div>&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"font-size: 1.2rem;\">В 1941 – 1942 годах Тетерман М.Е. участвовал в кругосветном переходе ледокола «Анастас Микоян»</span><span style=\"font-size: 1.2rem;\">&nbsp;из Чёрного моря в Бухту Провидения (Анадырский залив,&nbsp;</span><span style=\"font-size: 1.2rem;\">Берингово море).&nbsp;</span></div><br><div>&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"font-size: 1.2rem;\">Вероятно, после войны Тетерман М.Е. жил в городе Николаеве.</span><br></div></div>\n            <hr class=\"line\" mbr-style=\"{'width': lineLength + '%'}\">\n        </div>\n        </div>\n</section>",
          "_cid": "rCWyDj22vk",
          "_anchor": "content9-4w",
