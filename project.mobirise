              "margin": "0 auto"
            },
            ".section-text": {
              "padding": "2rem 0",
              "text-align": "left"
            },
            ".inner-container": {
              "margin": "0 auto"
            },
            "@media (max-width: 768px)": {
              ".inner-container": {
                "width": "100% !important"
              }
            },
            ".section-text DIV": {
              "text-align": "left"
            }
          },
          "_name": "content9",
          "_customHTML": "<section class=\"mbr-section article content9\" group=\"Article\">\n    \n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"0\">\n        <input type=\"range\" inline title=\"Text Width\" name=\"innerWidth\" min=\"50\" max=\"100\" step=\"1\" value=\"100\">\n        <input type=\"range\" inline title=\"Line Width\" name=\"lineLength\" min=\"10\" max=\"100\" step=\"1\" value=\"25\">\n        <input type=\"color\" title=\"Line Color\" name=\"lineColor\" value=\"#149dcc\">\n        <input type=\"color\" title=\"Background Color\" name=\"bgColor\" value=\"#ffffff\">\n    <!-- End block parameters -->\n    </mbr-parameters> \n\n    <div class=\"container\">\n        <div class=\"inner-container\" mbr-style=\"{'width': innerWidth + '%'}\">\n            <hr class=\"line\" mbr-style=\"{'width': lineLength + '%'}\">\n            <div class=\"section-text align-center mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".section-text\" mbr-text><p></p><p></p><p>&nbsp; &nbsp;Натан Моисеевич Изяков родился в 1920 году в\n&nbsp;<span style=\"font-size: 1.2rem;\">Звенигороде. &nbsp; &nbsp;</span></p><br><p>&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"font-size: 1.2rem;\">В 1939 году Изяков Н.М. был призван во флот.&nbsp;</span></p><br><p>&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"font-size: 1.2rem;\">В 1941 году Старший краснофлотец Изяков Н.М. был приписан в должности&nbsp;</span><span style=\"font-size: 1.2rem;\">кочегара второго котельного отделения к вспомогательному крейсеру «Анастас&nbsp;</span><span style=\"font-size: 1.2rem;\">Микоян».&nbsp;</span><span style=\"font-size: 1.2rem;\">В составе экипажа вспомогательного крейсера «А. Микоян» Изяков Н.М. </span><span style=\"font-size: 1.2rem;\">участвовал в обороне Одессы, Севастополя и Новороссийска.&nbsp;</span></p><br><p>&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"font-size: 1.2rem;\">В 1941 – 1942 годах Старший краснофлотец кочегар Изяков Н.М. участвовал в&nbsp;</span><span style=\"font-size: 1.2rem;\">кругосветном переходе ледокола &nbsp;«Анастас Микоян» из Чёрного моря в Бухту&nbsp;</span><span style=\"font-size: 1.2rem;\">Провидения (Анадырский залив, Берингово море).&nbsp;</span></p><br><p><span style=\"font-size: 1.2rem;\">&nbsp; &nbsp; После расформирования экипажа ледокола Натан Моисеевич&nbsp;</span><span style=\"font-size: 1.2rem;\">служил младшим баталером на эсминце «Карл Либкнехт».&nbsp;</span></p><p></p><br><p></p><p><span style=\"font-size: 1.2rem;\">&nbsp; &nbsp;&nbsp;</span><span style=\"font-size: 1.2rem;\">Натан Моисеевич был демобилизован в апреле 1947 года в звании старшины 2-ой статьи</span><br></p><p></p><p><br></p><p><span style=\"font-size: 1.2rem;\">&nbsp; &nbsp; После войны Натан Моисеевич Изяков проживал в городе Ивантеевка&nbsp;</span><span style=\"font-size: 1.2rem;\">Московской области, работал на Ивантеевкой трикотажной фабрике имени Ф. Э.&nbsp;</span><span style=\"font-size: 1.2rem;\">Дзержинского.&nbsp;</span><span style=\"font-size: 1.2rem;\">Изяков Н.М. поддерживал теплую дружбу с Николаем Ивановичем Кузовым.</span><br></p><br><p>&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"font-size: 1.2rem;\">Скончался Натан Моисеевич Изяков в 1992 году.</span><br></p><p></p><p></p><p></p><p></p><p></p></div>\n            <hr class=\"line\" mbr-style=\"{'width': lineLength + '%'}\">\n        </div>\n        </div>\n</section>",
          "_cid": "rSC65BSko6",
          "_anchor": "content9-1hc",
