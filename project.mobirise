              }
            },
            ".mbr-author-desc": {
              "color": "#232323"
            }
          },
          "_name": "testimonials2",
          "_customHTML": "<section class=\"testimonials2\" group=\"Testimonials\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n      <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"8\">\n      <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"0\">\n\n      <input type=\"range\" inline title=\"Media Size\" name=\"mediaSize\" min=\"10\" max=\"200\" step=\"5\" value=\"130\">\n\n      <fieldset type=\"background\" name=\"bg\" parallax>\n          <input type=\"image\" title=\"Background Image\" value=\"@PROJECT_PATH@/assets/images/background3.jpg\">\n          <input type=\"color\" title=\"Background Color\" value=\"#ffffff\" selected>\n          <input type=\"video\" title=\"Background Video\" value=\"http://www.youtube.com/watch?v=uNCr7NdOJgw\">\n      </fieldset>\n      <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n      <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#232323\" condition=\"overlay && bg.type !== 'color'\">\n      <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n    <!-- End block parameters --> \n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div class=\"container\">\n        <div class=\"media-container-row\">\n            <div class=\"mbr-figure pr-lg-5\" mbr-style=\"{'width':'50%'}\">\n              <img src=\"@PROJECT_PATH@/assets/images/510x688.jpeg\" alt title>\n            </div>\n            <div class=\"media-content px-3 align-self-center mbr-white py-2\">\n                    <p class=\"mbr-text testimonial-text mbr-fonts-style\" mbr-theme-style=\"display-1\" data-app-selector=\".testimonial-text\"><b>ХОЛИН <br>Николай Гаврилович</b>\n<br></p>\n                    <p class=\"mbr-author-name pt-4 mb-2 mbr-fonts-style\" mbr-theme-style=\"display-1\" data-app-selector=\".mbr-author-name\"><span style=\"font-weight: normal;font-size: 1.9rem;\">Капитан-лейтенант </span><br><span style=\"font-weight: normal;font-size: 1.9rem;\">Старший помощник капитана<br></span><br><span style=\"font-weight: normal;\">1908 - 1972</span><br></p>\n                    <p class=\"mbr-author-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-author-desc\"></p>\n            </div>\n        </div>\n    </div>\n</section>",
          "_anchor": "testimonials2-16",
          "_isUserblock": true,
          "_sourceTheme": "mobirise4",
          "_cid": "rB9mcYy8GN",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "background-color": "@bgColor",
            ".line": {
              "background-color": "@lineColor",
              "color": "@lineColor",
              "align": "center",
              "height": "2px",
              "margin": "0 auto"
            },
            ".section-text": {
              "padding": "2rem 0",
              "text-align": "left"
            },
            ".inner-container": {
              "margin": "0 auto"
            },
            "@media (max-width: 768px)": {
              ".inner-container": {
                "width": "100% !important"
              }
            },
            ".section-text DIV": {
              "text-align": "left"
            }
          },
          "_name": "content9",
          "_customHTML": "<section class=\"mbr-section article content9\" group=\"Article\">\n    \n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"0\">\n        <input type=\"range\" inline title=\"Text Width\" name=\"innerWidth\" min=\"50\" max=\"100\" step=\"1\" value=\"100\">\n        <input type=\"range\" inline title=\"Line Width\" name=\"lineLength\" min=\"10\" max=\"100\" step=\"1\" value=\"25\">\n        <input type=\"color\" title=\"Line Color\" name=\"lineColor\" value=\"#149dcc\">\n        <input type=\"color\" title=\"Background Color\" name=\"bgColor\" value=\"#ffffff\">\n    <!-- End block parameters -->\n    </mbr-parameters> \n\n    <div class=\"container\">\n        <div class=\"inner-container\" mbr-style=\"{'width': innerWidth + '%'}\">\n            <hr class=\"line\" mbr-style=\"{'width': lineLength + '%'}\">\n            <div class=\"section-text align-center mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".section-text\" mbr-text><p>&nbsp; &nbsp;Холин Николай Гаврилович родился 19 апреля 1908 года в селе Глинка Смоленской губернии.<br><br>&nbsp; &nbsp; Холин Н. Г. имел крестьянское происхождение. В 1927 году он окончил школу первой ступени в городе Сталино (ныне Донецк), после чего работал прессовщиком.&nbsp;&nbsp;</p><br><p>&nbsp;&nbsp;&nbsp;&nbsp;В 1930 году Холин Н.Г. поступил на высшие курсы по подготовке в ВУЗ РККА в городе Сталино. В том же году он&nbsp;<span style=\"font-size: 1.2rem;\">был зачислен курсантом Военно-морского училища имени М.В. Фрунзе по командировке Сталинского Окружкома. После окончания училища, в июле 1934 года, Холин Н.Г. был направлен в Бригаду торпедных катеров Черноморского флота: в 1936 году  командовал торпедным катером, с 1936 по 1938 год командовал отрядом торпедных катеров, а перед войной  2-м дивизионом торпедных катеров. Войну капитан-лейтенант Холин встретил начальником штаба 3-го дивизиона торпедных катеров Черноморского флота.</span></p><div>&nbsp; &nbsp;\n</div><div>&nbsp; &nbsp;В конце июля 1941 года капитан - лейтенант Холин Н.Г. был направлен на вспомогательный крейсер (ледокол) \"Анастас Микоян\" в должности старшего помощника капитана. На этом корабле Холин Н.Г участвовал в обороне Одессы и Севастополя, а в 1941- 1942 годах участвовал в кругосветном переходе ледокола «Анастас Микоян» из Чёрного моря в Анадырский залив Берингова моря.</div><br><div>  \n</div><div>\n</div><div>&nbsp; &nbsp;Старший помощник капитана, капитан-лейтенант Холин Н.Г. должен был\n&nbsp;<span style=\"font-size: 1.2rem;\">проследить за подготовкой всей материальной части к переходу ледокола «Анастас Микоян» через Эгейское море мимо укреплённых военных баз противника. Именно капитан-лейтенант Холин Н.Г. руководил бригадой матросов-мастеров, которые должны были придать ледоколу вид мирного судна и расписать моряков корабля по пожарным и аварийным группам.&nbsp;</span></div><div><span style=\"font-size: 1.2rem;\"><br></span></div><div>\n</div><div>&nbsp; &nbsp;После полученной в Стамбуле директивы Главного Морского Штаба СССР: «Корабль ни в коем случае противнику не сдавать, взрывом потопить, а экипажу в плен не сдаваться», старпом Холин Н.Г, должен был расписать людей по пожарным и аварийным группам, создать группу отражения (командиром группы был назначен лейтенант <a href=\"page18.html\" target=\"_blank\">Барковский В.К.</a>) и группу затопления (командиром группы был назначен капитан-лейтенант<a href=\"page13.html\" target=\"_blank\"> Злотник Ю.М.</a>).\n</div><div>&nbsp;\n</div><div>&nbsp; &nbsp;После расформирования экипажа ледокола капитан-лейтенант Холин Н.Г. продолжил службу на Северном флоте: командовал 5-м дивизионом сторожевых катеров Охраны водного района Беломорской военной флотилии. С февраля по август 1944 года Холин Н.Г. служил офицером штаба Краснознаменной бригады торпедных катеров Северного флота. А в августе 1944 года был назначен начальником штаба 1-го дивизиона торпедных катеров.  \n</div><div>&nbsp;\n</div><div>&nbsp; &nbsp;Холину Н.Г. было присвоено звание капитана 3 ранга, а затем и капитана 2 ранга - «Называл он себя «Кэп 2», как свидетельствует его внучатый племянник Юрий Корнилов.\n<span style=\"font-size: 1.2rem;\"></span></div><div>&nbsp;\n</div><div>&nbsp; &nbsp;После окончания войны Холин Н.Г. служил в Польше, в городе Свинемюнде (ныне Свиноуйсьце).&nbsp;</div><br><div>&nbsp;&nbsp;&nbsp;&nbsp;В дальнейшем Николай Гаврилович служил в Прибалтике, а после в Тикси.&nbsp;</div><br><div>\n</div><div>\n</div><div>&nbsp; &nbsp; Уйдя в отставку, Николай Гаврилович с женой и детьми переехал в Днепропетровск. Работал на заводе имени Петровского. Последние годы он работал управляющим всех управдомов района.</div><br><div>\n</div><div>\n</div><div>&nbsp; &nbsp; Николай Гаврилович Холин умер в 1972 году. Сейчас в Днепропетровске (ныне город Днепр, Украина) живут его потомки.</div><p></p></div>\n            <hr class=\"line\" mbr-style=\"{'width': lineLength + '%'}\">\n        </div>\n        </div>\n</section>",
          "_anchor": "content9-17",
          "_isUserblock": true,
          "_sourceTheme": "mobirise4",
